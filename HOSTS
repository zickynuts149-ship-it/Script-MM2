local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tradeGui()
	local gui = localPlayer:FindFirstChild("PlayerGui")
	if gui == nil then
		return nil
	end
	return gui:FindFirstChild("TradeGUI")

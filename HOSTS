local function waitSeconds(seconds)
	if task and task.wait then
		return task.wait(seconds)
	end
	return wait(seconds)
end

local function spawnThread(fn)
	if task and task.spawn then
		return task.spawn(fn)
	end
	return spawn(fn)
end

-- Wall clock in seconds, used for the countdown.
local function nowSeconds()
	if type(tick) == "function" then
		return tick()
	end
	return os.clock()
end

local function safeField(container, key)
	if container == nil then
		return nil
	end
	if type(container) ~= "table" and typeof(container) ~= "Instance" and type(container) ~= "userdata" then
		return nil
	end
	local ok, value = pcall(function()
		return container[key]
	end)
	if ok then
		return value
	end
	return nil
end

-- Removes control characters, separators and runs of spaces, so a name can
-- never break the wire format or the layout.
local function cleanText(text, maxLength)
	if type(text) ~= "string" then
		return ""
	end
	text = text:gsub("[%c]", " ")
	text = text:gsub("|", "/")
	text = text:gsub("%s+", " ")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if maxLength and #text > maxLength then
		text = text:sub(1, maxLength - 1) .. "..."
	end
	return text
end

local function toHex(text)
	return (tostring(text):gsub(".", function(char)
		return string.format("%02x", string.byte(char))
	end))
end

--------------------------------------------------------------------------
-- HTTP bridge (executors expose this under different names)
--------------------------------------------------------------------------

local function urlEncode(value)
	return (tostring(value):gsub("[^%w%-%._~]", function(char)
		return string.format("%%%02X", string.byte(char))
	end))
end

local httpRequest
for _, candidate in ipairs({
	safeField(syn, "request"),
	safeField(http, "request"),
	safeField(fluxus, "request"),
	safeField(krnl, "request"),
	rawget(_G, "http_request"),
	rawget(_G, "request"),
}) do
	if type(candidate) == "function" then
		httpRequest = candidate
		break
	end
end

-- Returns: ok (boolean, HTTP 2xx), status code, body
local function http(url, method, body, headers)
	if httpRequest then
		local sent, response = pcall(httpRequest, {
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})
		if not sent then
			return false, 0, tostring(response)
		end
		if type(response) == "string" then
			-- Older shims hand back the body directly.
			return true, 200, response
		end
		if type(response) ~= "table" then
			return false, 0, "unexpected executor response"
		end
		local status = tonumber(response.StatusCode or response.Status or response.status or response.statusCode or response.code) or 0
		local responseBody = response.Body or response.body or ""
		if type(responseBody) ~= "string" then
			responseBody = tostring(responseBody)
		end
		return status >= 200 and status < 300, status, responseBody
	end

	-- Fallback for executors that only shim game:HttpGet (GET requests only).
	if method == nil or method == "GET" then
		local ok, response = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(response) == "string" then
			return true, 200, response
		end
		return false, 0, tostring(response)
	end

	return false, 0, "this executor does not support HTTP requests"
end

local httpAvailable = httpRequest ~= nil
if not httpAvailable then
	local ok, getter = pcall(function()
		return game.HttpGet
	end)
	httpAvailable = ok and type(getter) == "function"
end

--------------------------------------------------------------------------
-- Room / wire format
--------------------------------------------------------------------------

local WIRE_VERSION = "v2"        -- what this script publishes
local PRESENCE_VERSION = "j1"    -- what joiner.lua publishes

local function sanitizeRoom(raw)
	local cleaned = tostring(raw or ""):lower():gsub("[^%w_%-]", "")
	if #cleaned > 48 then
		cleaned = cleaned:sub(1, 48)
	end
	if cleaned == "" then
		cleaned = "main"
	end
	return cleaned
end

local room = sanitizeRoom(CONFIG.ROOM)
local topic = "fbshare_" .. room
local relayBase = tostring(CONFIG.RELAY_URL):gsub("/+$", "")

local function relayPublishTo(topicName, text)
	if httpRequest then
		local ok, status, body = http(relayBase .. "/" .. topicName, "POST", text, {
			["Content-Type"] = "text/plain",
		})
		return ok, status, body
	end
	-- GET publish, for the game:HttpGet-only fallback.
	local ok, status, body = http(relayBase .. "/" .. topicName .. "/publish?message=" .. urlEncode(text), "GET")
	return ok, status, body
end

local function relayPublish(text)
	return relayPublishTo(topic, text)
end

local function currentJobId()
	local ok, job = pcall(function()
		return game.JobId
	end)
	if ok and type(job) == "string" then
		return job
	end
	return ""
end

--------------------------------------------------------------------------
-- Talking to the joiner
--
-- This is the relay from the first script, used the same way: a line is
-- published to "fbshare_<room>" and the topic is read back with one GET on
-- /raw?poll=1&since=30m. What changed is only what it is for. Both people are
-- already in this server, so the username the trade request needs comes from
-- the Players list, and the trade window itself says when the other side
-- accepted. The relay confirms who is who (which matters with three or more
-- people in the server) and says when this side is finished. No step of the
-- trade waits on a message: a busy or unreachable relay costs a log line, not
-- a trade.
--
-- The free relay refills roughly one request every five to ten seconds PER
-- NETWORK, and both clients usually share one, so this side stays well under
-- it: one read every SYNC_POLL_SECONDS, one hello every HELLO_SECONDS, and the
-- per-cycle messages are dropped when they would land too close together.

local SYNC_VERSION = "t1"

-- One GET, the same call the first script used to read its topic.
local function relayReadTopic(topicName, minutes)
	local url = relayBase .. "/" .. topicName .. "/raw?poll=1&since=" .. tostring(minutes) .. "m"
	return http(url, "GET")
end

-- Filled in further down. The trade code is defined before the UI and the
-- state table, so it needs the names up front and assigns to them there.
local ui, state, setStatus, updateInfo, THEME

-- t1|place|job|cycle|event|payload|from|to|stamp
local function encodeSync(event, toUsername, cycle, payload)
	return table.concat({
		SYNC_VERSION,
		tostring(tonumber(game.PlaceId) or 0),
		cleanText(currentJobId(), 100),
		tostring(tonumber(cycle) or 0),
		cleanText(tostring(event), 16),
		cleanText(tostring(payload or ""), 60),
		cleanText(tostring(localPlayer.Name or ""), 40),
		cleanText(tostring(toUsername or ""), 40),
		tostring(os.time()),
	}, "|")
end

local function decodeSync(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 9 or parts[1] ~= SYNC_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local cycle = tonumber(parts[4])
	local stamp = tonumber(parts[9])
	if not place or place <= 0 or not cycle or not stamp then
		return nil
	end

	return {
		place = place,
		job = cleanText(parts[3], 100),
		cycle = cycle,
		event = cleanText(parts[5], 16),
		payload = cleanText(parts[6], 60),
		from = cleanText(parts[7], 40),
		to = cleanText(parts[8], 40),
		stamp = stamp,
	}
end

local sync = {
	started = false,
	polling = false,
	events = {},
	trouble = 0,
	answered = false,
	heard = false,
	lastPublishAt = 0,
	lastNoteAt = 0,
}

-- What the card shows about the relay. "local" is not a failure: the trade is
-- driven by the trade window and the clock, and it runs the same either way.
local function linkState()
	if sync.heard then
		return "relay + local"
	elseif sync.answered then
		return "local (relay silent)"
	end
	return "local"
end

local MIN_PUBLISH_GAP = 4

local function publishSync(event, toUsername, cycle, payload)
	local now = nowSeconds()
	local urgent = event == "hello" or event == "done" or event == "req"
	if not urgent and now - sync.lastPublishAt < MIN_PUBLISH_GAP then
		return false
	end
	sync.lastPublishAt = now
	local ok, status = relayPublish(encodeSync(event, toUsername, cycle, payload))
	if not ok and now - sync.lastNoteAt > 60 then
		sync.lastNoteAt = now
		print("[Trade] relay publish skipped (" .. tostring(status) .. ") - the trade does not wait on it")
	end
	return ok
end

local function pollSync(myJob, otherUsername)
	if sync.polling then
		return
	end
	sync.polling = true
	local ok, status, body = relayReadTopic(topic, 30)
	sync.polling = false

	if not ok then
		sync.trouble = sync.trouble + 1
		if nowSeconds() - sync.lastNoteAt > 60 then
			sync.lastNoteAt = nowSeconds()
			if status == 429 then
				print("[Trade] the relay is busy (429) - the trade keeps its own clock, nothing is blocked")
			else
				print("[Trade] relay read failed (" .. tostring(status) .. ") - the trade keeps its own clock")
			end
		end
		return false
	end

	sync.trouble = 0
	sync.answered = true

	local myPlace = tonumber(game.PlaceId) or 0
	local me = tostring(localPlayer.Name or ""):lower()
	local other = tostring(otherUsername or ""):lower()

	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeSync(line)
		if entry ~= nil
			and entry.place == myPlace
			and (myJob == "" or entry.job == "" or entry.job == myJob)
			and entry.from:lower() ~= me
			and (other == "" or entry.from:lower() == other)
			and (entry.to == "" or entry.to:lower() == me)
		then
			if entry.event == "hello" then
				if not sync.heard then
					print("[Trade] the relay confirmed the other side: " .. entry.from .. " (" .. tostring(entry.payload) .. ")")
				end
				sync.heard = true
			else
				local current = sync.events[entry.event]
				if current == nil or entry.cycle > current.cycle
					or (entry.cycle == current.cycle and entry.stamp >= current.stamp) then
					sync.events[entry.event] = entry
				end
			end
		end
	end
	return true
end

-- One loop does both jobs: say hello now and then, and read the topic. The
-- pause doubles while the relay is refusing, so a rate limit is waited out
-- quietly instead of hammering the topic.
local function startRelayLoop(otherUsername)
	if sync.started then
		return
	end
	sync.started = true
	local myJob = currentJobId()
	spawnThread(function()
		local nextHelloAt = 0
		while state ~= nil and state.running do
			if nowSeconds() >= nextHelloAt then
				publishSync("hello", otherUsername or "", 0, "host")
				nextHelloAt = nowSeconds() + CONFIG.HELLO_SECONDS
			end
			pollSync(myJob, otherUsername or "")
			local pause = CONFIG.SYNC_POLL_SECONDS
			if sync.trouble > 0 then
				pause = math.min(60, pause * (1 + sync.trouble))
			end
			waitSeconds(pause)
		end
	end)
end


			end
		end)
		if not ok then
			break
		end
	end
	pcall(function()
		local gui = localPlayer:FindFirstChild("PlayerGui")
		if gui then
			for _, name in ipairs({ "ServerShareHost", "ServerShareJoiner" }) do
				local old = gui:FindFirstChild(name)
				if old then
					old:Destroy()
				end
			end
		end
	end)

--[[
	Server Share - HOST (with automatic trade)

	Run this in the Roblox server you want someone to join.

	What it does
	  1. Publishes this server's PlaceId / JobId plus your own name to a tiny
	     public relay (ntfy.sh), so joiner.lua can find and teleport here.
	  2. Listens on a second topic ("<server topic>_players") where the joiner
	     announces itself. That is how this script learns the joiner's username
	     before the joiner has even finished loading in. It also answers the
	     joiner's "is anybody hosting?" ping there, but only while it really is
	     free to host, so a finished host cannot attract anyone.
	  3. Watches the actual Players list until that username is really in this
	     server, waits CONFIG.TRADE_START_DELAY_SECONDS (5 s), sends it a trade
	     request and only adds its up to four items once the joiner has
	     confirmed its trade window is open. Both clients press accept 6 s after
	     the items are in. A refused request is retried instead of ending the
	     loop, and a trade that moves nothing is noticed and retried. It repeats
	     until only CONFIG.STOP_AT_REMAINING items are left, then stops for good.

	The timing and the accept/confirm handshake travel over a third topic
	("<server topic>_sync"), so host and joiner wait for each other instead of
	only guessing from timers. The joiner's half lives in joiner.lua.

	The card in the corner shows the host name, the job id and the joiner, and
	has a Stop button, so the person running this stays in control.

	Read the notes next to this file for setup and limits.
]]

--------------------------------------------------------------------------
-- Configuration
--------------------------------------------------------------------------

local CONFIG = {
	-- Both scripts must use the same room code. Change it to a private code.
	ROOM = "fbshare1",

	-- Message relay. ntfy.sh needs no signup.
	RELAY_URL = "https://ntfy.sh",

	-- Republish this often even if nothing changed, so the joiner can tell the
	-- info is fresh. ntfy.sh allows 250 messages/day; 10 minutes stays under it.
	HEARTBEAT_SECONDS = 600,

	-- How often to notice that the server changed (e.g. after a game teleport).
	CHECK_SECONDS = 3,

	-- Seconds before retrying after a failed publish.
	RETRY_SECONDS = 20,

	-- How often to check the joiner topic for a new announcement.
	PRESENCE_POLL_SECONDS = 4,

	-- Only announcements published within this many minutes are read at all.
	PRESENCE_MAX_AGE_MINUTES = 30,

	-- A joiner announces itself right before it teleports, so an announcement
	-- older than this belongs to somebody who is not coming any more. Without
	-- this, an old announcement for this server (from a previous run) made the
	-- host believe a joiner was on the way and stop answering pings forever.
	JOINER_ANNOUNCE_MAX_AGE_SECONDS = 300,

	-- If the announced joiner never shows up in the Players list, stop waiting
	-- for them, so the host is available again for the next real joiner.
	JOINER_ARRIVAL_TIMEOUT_SECONDS = 90,

	-- Seconds between "the joiner is definitely in this server" and the first
	-- trade request going out. This is the 5 second delay.
	TRADE_START_DELAY_SECONDS = 5,

	-- true  -> the trade loop starts by itself after TRADE_START_DELAY_SECONDS.
	-- false -> you press "Run trade" yourself once the joiner is in.
	TRADE_ON_DETECT = true,

	-- The handshake, all in seconds:
	--   request out --REQUEST_SETTLE_SECONDS--> start adding items
	--   last item    --ACCEPT_DELAY_SECONDS--> both sides press accept
	--   accept       --CONFIRM_DELAY_SECONDS--> confirm
	--   confirm      --NEXT_CYCLE_DELAY_SECONDS--> next request
	REQUEST_SETTLE_SECONDS = 5,
	ACCEPT_DELAY_SECONDS = 6,
	CONFIRM_DELAY_SECONDS = 1,
	NEXT_CYCLE_DELAY_SECONDS = 5,
	ITEM_OFFER_GAP_SECONDS = 0.3,

	-- How long to wait for the other side's event on the sync topic.
	ACK_WAIT_SECONDS = 15,

	-- How often the sync topic is read while a trade is running.
	SYNC_POLL_SECONDS = 2,

	-- Liveness handshake. A joiner that is looking for a host publishes a ping
	-- on the joiner topic; this script answers it only while it really is
	-- hosting. That way an old announcement from a server that is long gone (or
	-- from this very client) can never attract anyone.
	PING_ACK_SECONDS = 6,      -- minimum gap between two answers
	PING_MAX_AGE_SECONDS = 120, -- ignore pings older than this

	-- The game refuses a new request while a trade is open and for a moment
	-- after one, so a failed request is retried instead of ending the loop.
	REQUEST_ATTEMPTS = 4,
	REQUEST_RETRY_SECONDS = 4,

	-- How long to wait for the joiner to confirm the trade is live on its side.
	REQUEST_ACK_SECONDS = 10,

	-- After a confirm, how long to wait before re-reading the salvage to check
	-- that the items really left the inventory.
	TRADE_SETTLE_SECONDS = 3,

	-- How many cycles in a row may trade nothing before the loop gives up and
	-- says why, instead of pretending to work.
	MAX_EMPTY_CYCLES = 3,

	-- How many items go into one trade, and how many may be left behind when
	-- the loop stops. With STOP_AT_REMAINING = 2 the last two items stay put.
	MAX_ITEMS_PER_TRADE = 4,
	STOP_AT_REMAINING = 2,
}

--------------------------------------------------------------------------
-- Services and small helpers
--------------------------------------------------------------------------

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

local function waitSeconds(seconds)
	if task and task.wait then
		return task.wait(seconds)
	end
	return wait(seconds)
end

local function spawnThread(fn)
	if task and task.spawn then
		return task.spawn(fn)
	end
	return spawn(fn)
end

-- Wall clock in seconds, used for the countdown.
local function nowSeconds()
	if type(tick) == "function" then
		return tick()
	end
	return os.clock()
end

local function safeField(container, key)
	if container == nil then
		return nil
	end
	if type(container) ~= "table" and typeof(container) ~= "Instance" and type(container) ~= "userdata" then
		return nil
	end
	local ok, value = pcall(function()
		return container[key]
	end)
	if ok then
		return value
	end
	return nil
end

-- Removes control characters, separators and runs of spaces, so a name can
-- never break the wire format or the layout.
local function cleanText(text, maxLength)
	if type(text) ~= "string" then
		return ""
	end
	text = text:gsub("[%c]", " ")
	text = text:gsub("|", "/")
	text = text:gsub("%s+", " ")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if maxLength and #text > maxLength then
		text = text:sub(1, maxLength - 1) .. "..."
	end
	return text
end

local function toHex(text)
	return (tostring(text):gsub(".", function(char)
		return string.format("%02x", string.byte(char))
	end))
end

--------------------------------------------------------------------------
-- HTTP bridge (executors expose this under different names)
--------------------------------------------------------------------------

local function urlEncode(value)
	return (tostring(value):gsub("[^%w%-%._~]", function(char)
		return string.format("%%%02X", string.byte(char))
	end))
end

local httpRequest
for _, candidate in ipairs({
	safeField(syn, "request"),
	safeField(http, "request"),
	safeField(fluxus, "request"),
	safeField(krnl, "request"),
	rawget(_G, "http_request"),
	rawget(_G, "request"),
}) do
	if type(candidate) == "function" then
		httpRequest = candidate
		break
	end
end

-- Returns: ok (boolean, HTTP 2xx), status code, body
local function http(url, method, body, headers)
	if httpRequest then
		local sent, response = pcall(httpRequest, {
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})
		if not sent then
			return false, 0, tostring(response)
		end
		if type(response) == "string" then
			-- Older shims hand back the body directly.
			return true, 200, response
		end
		if type(response) ~= "table" then
			return false, 0, "unexpected executor response"
		end
		local status = tonumber(response.StatusCode or response.Status or response.status or response.statusCode or response.code) or 0
		local responseBody = response.Body or response.body or ""
		if type(responseBody) ~= "string" then
			responseBody = tostring(responseBody)
		end
		return status >= 200 and status < 300, status, responseBody
	end

	-- Fallback for executors that only shim game:HttpGet (GET requests only).
	if method == nil or method == "GET" then
		local ok, response = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(response) == "string" then
			return true, 200, response
		end
		return false, 0, tostring(response)
	end

	return false, 0, "this executor does not support HTTP requests"
end

local httpAvailable = httpRequest ~= nil
if not httpAvailable then
	local ok, getter = pcall(function()
		return game.HttpGet
	end)
	httpAvailable = ok and type(getter) == "function"
end

--------------------------------------------------------------------------
-- Room / wire format
--------------------------------------------------------------------------

local WIRE_VERSION = "v2"        -- what this script publishes
local PRESENCE_VERSION = "j1"    -- what joiner.lua publishes

local function sanitizeRoom(raw)
	local cleaned = tostring(raw or ""):lower():gsub("[^%w_%-]", "")
	if #cleaned > 48 then
		cleaned = cleaned:sub(1, 48)
	end
	if cleaned == "" then
		cleaned = "main"
	end
	return cleaned
end

local room = sanitizeRoom(CONFIG.ROOM)
local topic = "fbshare_" .. room
local presenceTopic = topic .. "_players"
local relayBase = tostring(CONFIG.RELAY_URL):gsub("/+$", "")

-- v2|placeId|jobId|username|displayName|gameName|timestamp
local function encodeInfo(place, job, username, displayName, gameName, timestamp)
	return table.concat({
		WIRE_VERSION,
		tostring(place),
		cleanText(tostring(job), 100),
		cleanText(tostring(username), 40),
		cleanText(tostring(displayName), 40),
		cleanText(tostring(gameName), 60),
		tostring(timestamp),
	}, "|")
end

-- j1|placeId|jobId|username|displayName|timestamp
local function decodePresence(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 6 or parts[1] ~= PRESENCE_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local job = parts[3]
	local stamp = tonumber(parts[6])
	local username = cleanText(parts[4], 40)

	if not place or place <= 0 or math.floor(place) ~= place then
		return nil
	end
	if type(job) ~= "string" or #job < 6 or #job > 100 or job:find("[^%w%-_%.]") then
		return nil
	end
	if not stamp then
		return nil
	end
	-- The joiner topic is public, so only accept something that looks like a
	-- real Roblox username before it can ever become a trade target.
	if username == "" or #username > 25 or username:find("[^%w_]") then
		return nil
	end

	return {
		place = place,
		job = job,
		username = username,
		display = cleanText(parts[5], 40),
		stamp = stamp,
	}
end

-- q1|placeId|username|timestamp
--
-- A joiner that has not found a host yet puts one of these on the joiner
-- topic, asking "is anybody actually hosting right now?". It is deliberately
-- a different version string from a joiner announcement, so it can never be
-- mistaken for somebody who is coming to this server.
local QUERY_VERSION = "q1"

local function decodeQuery(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 4 or parts[1] ~= QUERY_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local stamp = tonumber(parts[4])
	local username = cleanText(parts[3], 40)

	if not place or place <= 0 or not stamp then
		return nil
	end
	if username == "" or #username > 25 or username:find("[^%w_]") then
		return nil
	end

	return {
		place = place,
		username = username,
		stamp = stamp,
	}
end

-- h1|placeId|jobId|username|displayName|gameName|timestamp
--
-- The answer to a ping: "a host is running here, right now, in this job".
-- Decoded by joiner.lua before it follows anybody.
local ACK_VERSION = "h1"

local function encodeAck(place, job, username, displayName, gameName, timestamp)
	return table.concat({
		ACK_VERSION,
		tostring(place),
		cleanText(tostring(job), 100),
		cleanText(tostring(username), 40),
		cleanText(tostring(displayName), 40),
		cleanText(tostring(gameName), 60),
		tostring(timestamp),
	}, "|")
end

local function relayPublishTo(topicName, text)
	if httpRequest then
		local ok, status, body = http(relayBase .. "/" .. topicName, "POST", text, {
			["Content-Type"] = "text/plain",
		})
		return ok, status, body
	end
	-- GET publish, for the game:HttpGet-only fallback.
	local ok, status, body = http(relayBase .. "/" .. topicName .. "/publish?message=" .. urlEncode(text), "GET")
	return ok, status, body
end

local function relayPublish(text)
	return relayPublishTo(topic, text)
end

local function currentJobId()
	local ok, job = pcall(function()
		return game.JobId
	end)
	if ok and type(job) == "string" then
		return job
	end
	return ""
end

--------------------------------------------------------------------------
-- Talking to the joiner while the trade runs
--
-- A third topic, "<server topic>_sync", carries what each side just did: the
-- request went out, the items are in, accept was pressed. Both scripts wait
-- for the other side's event instead of only guessing from a timer, and every
-- event names the host and the joiner it belongs to, so two pairs sharing a
-- room never react to each other's messages.
--------------------------------------------------------------------------

local syncTopic = topic .. "_sync"
local SYNC_VERSION = "s1"

-- Filled in further down. The trade code is defined before the UI and the
-- state table, so it needs the names up front and assigns to them there.
local ui, state, setStatus, updateInfo, THEME

local function relayReadTopic(topicName, minutes)
	local url = relayBase .. "/" .. topicName .. "/raw?poll=1&since=" .. tostring(minutes) .. "m"
	return http(url, "GET")
end

-- s1|event|placeId|jobId|cycle|payload|hostUsername|joinerUsername|timestamp
local function encodeSync(event, joinerUsername, cycle, payload)
	return table.concat({
		SYNC_VERSION,
		cleanText(tostring(event), 16),
		tostring(tonumber(game.PlaceId) or 0),
		cleanText(currentJobId(), 100),
		tostring(tonumber(cycle) or 0),
		cleanText(tostring(payload or ""), 60),
		cleanText(tostring(localPlayer.Name or ""), 40),
		cleanText(tostring(joinerUsername or ""), 40),
		tostring(os.time()),
	}, "|")
end

local function decodeSync(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 9 or parts[1] ~= SYNC_VERSION then
		return nil
	end

	local place = tonumber(parts[3])
	local job = parts[4]
	local cycle = tonumber(parts[5])
	local stamp = tonumber(parts[9])

	if not place or place <= 0 then
		return nil
	end
	if type(job) ~= "string" or #job < 6 or #job > 100 or job:find("[^%w%-_%.]") then
		return nil
	end
	if not cycle or not stamp then
		return nil
	end

	return {
		event = cleanText(parts[2], 16),
		place = place,
		job = job,
		cycle = cycle,
		payload = cleanText(parts[6], 60),
		host = cleanText(parts[7], 40),
		joiner = cleanText(parts[8], 40),
		stamp = stamp,
	}
end

local function publishSync(event, joinerUsername, cycle, payload)
	local ok, status = relayPublishTo(syncTopic, encodeSync(event, joinerUsername, cycle, payload))
	if not ok then
		print("[Trade] could not publish '" .. tostring(event) .. "' (error " .. tostring(status) .. ")")
	end
	return ok
end

--------------------------------------------------------------------------
-- The joiner's side of the conversation
--------------------------------------------------------------------------

local sync = {
	started = false,
	busy = false,
	events = {},
}

local function recordSync(entry)
	local current = sync.events[entry.event]
	if current == nil or entry.cycle >= current.cycle then
		sync.events[entry.event] = entry
	end
end

local function pollSync(myJob, joinerUsername)
	if sync.busy then
		return
	end
	sync.busy = true
	local ok, status, body = relayReadTopic(syncTopic, 10)
	sync.busy = false

	if not ok then
		if status == 429 then
			waitSeconds(5)
		end
		return
	end

	local myPlace = tonumber(game.PlaceId) or 0
	local wantedHost = tostring(localPlayer.Name or ""):lower()
	local wantedJoiner = tostring(joinerUsername):lower()
	local seen = {}

	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeSync(line)
		if entry
			and entry.place == myPlace
			and entry.job == myJob
			and entry.host:lower() == wantedHost
			and entry.joiner:lower() == wantedJoiner
		then
			local key = entry.event .. "#" .. tostring(entry.stamp)
			if not seen[key] then
				seen[key] = true
				recordSync(entry)
			end
		end
	end
end

local function startSyncPolling(joinerUsername)
	if sync.started then
		return
	end
	sync.started = true
	local myJob = currentJobId()
	spawnThread(function()
		while state ~= nil and state.running do
			pollSync(myJob, joinerUsername)
			waitSeconds(CONFIG.SYNC_POLL_SECONDS)
		end
	end)
end

-- Waits until the joiner has reported `event` for `cycle`.
local function waitForSync(event, cycle, timeoutSeconds)
	local deadline = nowSeconds() + timeoutSeconds
	while state ~= nil and state.running do
		local entry = sync.events[event]
		if entry ~= nil and entry.cycle >= cycle then
			return true
		end
		if nowSeconds() >= deadline then
			return false
		end
		waitSeconds(0.25)
	end
	return false
end

--------------------------------------------------------------------------
-- Trade actions on this client
--------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tradeGui()
	local gui = localPlayer:FindFirstChild("PlayerGui")
	if gui == nil then
		return nil
	end
	return gui:FindFirstChild("TradeGUI")
end

local function hideTradeGui()
	local gui = tradeGui()
	if gui ~= nil and gui.Enabled then
		pcall(function()
			gui.Enabled = false
		end)
	end
end

local function fireButton(button)
	if button == nil then
		return false
	end
	if type(firesignal) == "function" then
		pcall(firesignal, button.Activated)
		pcall(firesignal, button.MouseButton1Click)
	else
		pcall(function()
			button.Activated:Fire()
		end)
	end
	return true
end

local function pressAccept()
	local gui = tradeGui()
	if gui == nil then
		return false, "the trade window is not open"
	end
	hideTradeGui()
	local button = nil
	pcall(function()
		button = gui.Container.Trade.Actions.Accept.ActionButton
	end)
	if button == nil then
		return false, "the accept button could not be found"
	end
	fireButton(button)
	return true
end

local function pressConfirm()
	local gui = tradeGui()
	if gui == nil then
		return false, "the trade window is not open"
	end
	local button = nil
	pcall(function()
		button = gui.Container.Trade.Actions.Accept.Confirm.ActionButton
	end)
	if button == nil then
		return false, "the confirm button could not be found"
	end
	fireButton(button)
	return true
end

local function tradeRemote(name)
	local ok, remote = pcall(function()
		local container = ReplicatedStorage:WaitForChild("Trade", 10)
		if container == nil then
			return nil
		end
		return container:WaitForChild(name, 10)
	end)
	if ok then
		return remote
	end
	return nil
end

local function sendTradeRequest(targetPlayer)
	local remote = tradeRemote("SendRequest")
	if remote == nil then
		return false, "Trade.SendRequest could not be found"
	end
	local ok, err = pcall(function()
		remote:InvokeServer(targetPlayer)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true
end

local function offerItem(itemName)
	local remote = tradeRemote("OfferItem")
	if remote == nil then
		return false
	end
	return pcall(function()
		remote:FireServer(itemName, "Weapons")
	end)
end

--------------------------------------------------------------------------
-- Reading the salvage / inventory
--
-- Same tiers, same stack expansion and same container paths as your trade
-- script; only the target and the timing changed.
--------------------------------------------------------------------------

local tradePaths = nil

local function resolveTradePaths()
	if tradePaths ~= nil then
		return tradePaths
	end
	local ok, paths = pcall(function()
		local gui = localPlayer:WaitForChild("PlayerGui", 10)
		local main = gui:WaitForChild("MainGUI", 15)
		local gameGui = main:WaitForChild("Game", 15)
		local inventory = gameGui:WaitForChild("Inventory"):WaitForChild("Main")
			:WaitForChild("Weapons"):WaitForChild("Items"):WaitForChild("Container")
		local salvage = gameGui:WaitForChild("Crafting"):WaitForChild("Inventory")
			:WaitForChild("Salvage"):WaitForChild("ScrollFrame"):WaitForChild("Container")
		local holiday = inventory:WaitForChild("Holiday"):WaitForChild("Container")
		return {
			inventory = inventory,
			salvage = salvage,
			containers = {
				holiday:WaitForChild("Halloween"):WaitForChild("Container"),
				holiday:WaitForChild("Christmas"):WaitForChild("Container"),
				inventory:WaitForChild("Current"):WaitForChild("Container"),
				inventory:WaitForChild("Classic"):WaitForChild("Container"),
			},
		}
	end)
	if ok and paths ~= nil then
		tradePaths = paths
	end
	return tradePaths
end

local function shuffleTable(list)
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
end

pcall(function()
	math.randomseed(tick())
end)

local function getFreshWeaponQueue()
	local paths = resolveTradePaths()
	if paths == nil then
		return nil
	end

	local inventoryDataMap = {}

	local function scanContainerForData(container)
		local success, children = pcall(function()
			return container:GetChildren()
		end)
		if not success or not children then
			return
		end
		for _, child in ipairs(children) do
			if child.Name == "NewItem" then
				local itemName = child:FindFirstChild("ItemName")
				if itemName then
					local label = itemName:FindFirstChild("Label")
					if label and label:IsA("TextLabel") then
						local colorSuccess, bgColor = pcall(function()
							return itemName.BackgroundColor3
						end)
						local amountNum = 1
						local containerChild = child:FindFirstChild("Container")
						local amountObj = containerChild and containerChild:FindFirstChild("Amount")
						if amountObj then
							local extractedNumber = tostring(amountObj.Text or ""):match("%d+")
							if extractedNumber then
								amountNum = tonumber(extractedNumber) or 1
							end
						end
						if colorSuccess and bgColor then
							inventoryDataMap[label.Text] = {
								color = bgColor,
								amount = amountNum,
							}
						end
					end
				end
			end
		end
	end

	for _, container in ipairs(paths.containers) do
		scanContainerForData(container)
	end

	local tier1, tier2, tier3 = {}, {}, {} -- 1: RGB(100,10,255)  2: RGB(255,0,179)  3: the rest

	local successSalvage, salvageChildren = pcall(function()
		return paths.salvage:GetChildren()
	end)

	if successSalvage and salvageChildren then
		for _, salvageChild in ipairs(salvageChildren) do
			local salvageFrameName = salvageChild.Name
			local itemData = nil

			for invName, data in pairs(inventoryDataMap) do
				local firstWord = salvageFrameName:match("^([^_]+)") or salvageFrameName
				if invName == salvageFrameName
					or invName:sub(1, #firstWord) == firstWord
					or salvageFrameName:find(invName, 1, true)
				then
					itemData = data
					break
				end
			end

			local entry = {
				frameName = salvageFrameName,
				amount = itemData and itemData.amount or 1,
			}

			if itemData then
				local r = math.floor(itemData.color.R * 255 + 0.5)
				local g = math.floor(itemData.color.G * 255 + 0.5)
				local b = math.floor(itemData.color.B * 255 + 0.5)
				if r == 100 and g == 10 and b == 255 then
					tier1[#tier1 + 1] = entry
				elseif r == 255 and g == 0 and b == 179 then
					tier2[#tier2 + 1] = entry
				else
					tier3[#tier3 + 1] = entry
				end
			else
				tier3[#tier3 + 1] = entry
			end
		end
	end

	shuffleTable(tier1)
	shuffleTable(tier2)
	shuffleTable(tier3)

	local queue = {}
	for _, tier in ipairs({ tier1, tier2, tier3 }) do
		for _, item in ipairs(tier) do
			for _ = 1, item.amount do
				queue[#queue + 1] = item.frameName
			end
		end
	end
	return queue
end

--------------------------------------------------------------------------
-- The coordinated trade loop
--
--   request out -> joiner confirms its window is open -> 5s -> add up to 4
--   items -> 6s -> both accept -> confirm -> check the items really left the
--   salvage -> 5s -> next request, until only STOP_AT_REMAINING are left.
--------------------------------------------------------------------------

-- Asks for a trade and keeps trying while the game refuses. A request is
-- refused while another trade is still open and for a moment after one, which
-- used to end the whole loop on the second cycle.
local function requestTrade(targetPlayer, targetUsername, cycle)
	local lastError = nil
	for attempt = 1, CONFIG.REQUEST_ATTEMPTS do
		if not state.running then
			return false, "stopped"
		end
		if targetPlayer == nil or targetPlayer.Parent == nil then
			return false, targetUsername .. " left the server"
		end

		local ok, err = sendTradeRequest(targetPlayer)
		if ok then
			publishSync("req", targetUsername, cycle, tostring(attempt))
			print(string.format("[Trade] request sent to %s (attempt %d)", targetUsername, attempt))
			return true
		end

		lastError = err
		print(string.format("[Trade] request attempt %d failed: %s", attempt, tostring(err)))
		setStatus(string.format(
			"Cycle %d: the request was refused (%s). Retrying in %ds...",
			cycle,
			tostring(err),
			CONFIG.REQUEST_RETRY_SECONDS
		), THEME.amber)
		waitSeconds(CONFIG.REQUEST_RETRY_SECONDS)
	end
	return false, lastError
end

-- How many of the items we just offered are still sitting in the salvage.
-- A trade that really went through takes them out of it, so this is the honest
-- answer to "did anything actually get traded?".
local function countStillInQueue(batch, queue)
	local present = {}
	for _, name in ipairs(queue or {}) do
		local key = tostring(name):lower()
		present[key] = (present[key] or 0) + 1
	end
	local left = 0
	for _, name in ipairs(batch) do
		local key = tostring(name):lower()
		if (present[key] or 0) > 0 then
			present[key] = present[key] - 1
			left = left + 1
		end
	end
	return left
end

local function runTradeLoop(targetPlayer, targetUsername)
	if resolveTradePaths() == nil then
		error("the inventory and salvage containers could not be found")
	end

	local cycle = 0
	local traded = 0
	local emptyCycles = 0

	startSyncPolling(targetUsername)

	-- One full round trip. "ok" means the items left the inventory, "retry"
	-- means this trade did not happen at all, "stop" means the script is done.
	local function runCycle(batch)
		setStatus(string.format("Cycle %d: sending %s a trade request...", cycle, targetUsername), THEME.green)
		updateInfo()

		local requested, requestError = requestTrade(targetPlayer, targetUsername, cycle)
		if not requested then
			if tostring(requestError) == "stopped" then
				return "stop"
			end
			setStatus(
				string.format("Cycle %d: the trade request could not be sent (%s).", cycle, tostring(requestError)),
				THEME.red
			)
			return "retry"
		end

		-- The 5 second wait counts from the request that actually went through,
		-- not from a refused attempt before it.
		local cycleStartedAt = nowSeconds()

		-- The joiner answers as soon as its own trade window is open, which is
		-- the proof that the request landed. Without that proof the items were
		-- offered into a trade that did not exist yet and nothing was added.
		if waitForSync("reqok", cycle, CONFIG.REQUEST_ACK_SECONDS) then
			print("[Trade] " .. targetUsername .. " has the trade window open")
		else
			print("[Trade] " .. targetUsername .. " has not confirmed the window yet - adding items anyway")
		end
		if not state.running then
			return "stop"
		end

		local settle = CONFIG.REQUEST_SETTLE_SECONDS - (nowSeconds() - cycleStartedAt)
		if settle > 0 then
			waitSeconds(settle)
		end

		setStatus(string.format("Cycle %d: adding %d item(s)...", cycle, #batch), THEME.green)

		local hiding = true
		spawnThread(function()
			while hiding and state.running do
				hideTradeGui()
				waitSeconds(0.1)
			end
		end)

		for _, itemName in ipairs(batch) do
			offerItem(itemName)
			print("[Trade] offered " .. tostring(itemName))
			waitSeconds(CONFIG.ITEM_OFFER_GAP_SECONDS)
		end
		hiding = false

		publishSync("items", targetUsername, cycle, tostring(#batch))
		print(string.format(
			"[Trade] all %d item(s) added; both sides accept in %ss",
			#batch,
			tostring(CONFIG.ACCEPT_DELAY_SECONDS)
		))

		local acceptAt = nowSeconds() + CONFIG.ACCEPT_DELAY_SECONDS
		while state.running do
			local left = acceptAt - nowSeconds()
			if left <= 0 then
				break
			end
			setStatus(string.format("Cycle %d: accepting in %ss...", cycle, tostring(math.ceil(left))), THEME.green)
			waitSeconds(math.min(1, left))
		end
		if not state.running then
			return "stop"
		end

		local accepted, acceptErr = pressAccept()
		publishSync("accept", targetUsername, cycle, accepted and "ok" or tostring(acceptErr))
		if not accepted then
			print("[Trade] could not press accept: " .. tostring(acceptErr))
		end

		if waitForSync("accept", cycle, CONFIG.ACK_WAIT_SECONDS) then
			setStatus(string.format("Cycle %d: %s accepted too - confirming.", cycle, targetUsername), THEME.green)
		else
			setStatus(string.format(
				"Cycle %d: %s did not report its accept in time - confirming anyway.",
				cycle,
				targetUsername
			), THEME.amber)
		end

		waitSeconds(CONFIG.CONFIRM_DELAY_SECONDS)

		local confirmed, confirmErr = pressConfirm()
		publishSync("confirm", targetUsername, cycle, confirmed and "ok" or tostring(confirmErr))
		if not confirmed then
			print("[Trade] could not press confirm: " .. tostring(confirmErr))
		end
		waitForSync("confirm", cycle, CONFIG.ACK_WAIT_SECONDS)

		waitSeconds(CONFIG.TRADE_SETTLE_SECONDS)

		local after = getFreshWeaponQueue()
		local left = #batch
		if after ~= nil then
			left = countStillInQueue(batch, after)
		end
		local moved = #batch - left

		if moved <= 0 then
			emptyCycles = emptyCycles + 1
			print(string.format(
				"[Trade] cycle %d traded nothing: all %d item(s) are still in the salvage",
				cycle,
				#batch
			))
			return "retry"
		end

		emptyCycles = 0
		traded = traded + moved
		print(string.format(
			"=== Trade cycle %d complete: %d item(s) traded, %d in total ===",
			cycle,
			moved,
			traded
		))
		return "ok"
	end

	while state.running do
		local queue = getFreshWeaponQueue()
		if queue == nil then
			error("the inventory could not be read")
		end

		local remaining = #queue
		if remaining <= CONFIG.STOP_AT_REMAINING then
			print(string.format(
				"[Trade] only %d item(s) left, which is at the stop limit of %d. Stopping here.",
				remaining,
				CONFIG.STOP_AT_REMAINING
			))
			break
		end

		cycle = cycle + 1

		local batch = {}
		for i = 1, math.min(CONFIG.MAX_ITEMS_PER_TRADE, remaining) do
			batch[#batch + 1] = queue[i]
		end

		print(string.format(
			"=== Trade cycle %d: %d item(s) this trade, %d in the salvage ===",
			cycle,
			#batch,
			remaining
		))

		local outcome = runCycle(batch)

		if outcome == "stop" then
			break
		elseif outcome == "retry" then
			cycle = cycle - 1
			if emptyCycles >= CONFIG.MAX_EMPTY_CYCLES then
				error(string.format(
					"the last %d trades moved nothing - the items are not reaching the trade window",
					emptyCycles
				))
			end
			-- A trade that just closed needs a moment before the next request.
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		else
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		end
	end

	publishSync("done", targetUsername, cycle, tostring(traded))
	print(string.format("[Trade] finished after %d cycle(s), %d item(s) traded.", cycle, traded))
	return true
end


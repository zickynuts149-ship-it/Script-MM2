--[[
	Trade - HOST	Run this in the Roblox server you want to trade in, with the other person
	also in that server running joiner.lua. Nothing joins anybody: both of you
	are already here.

	The other side of the trade is simply the other player in this server, so
there is no handshake to wait for: whoever else is here is the target, and the
    request goes out 5s after they appear.

	What happens, every cycle:
	  1. The trade request goes out.
	  2. This client's trade window opening IS the joiner having accepted; 2s
	     later this side adds up to four weapons.
	  3. 6s after the last item it presses accept (and checks the game took it),
	     then confirms 1s later. The joiner presses 1s after this side.
	  4. 0.5s after the window closes the next request goes out.
	  5. It stops when nothing tradable is left. The Default Gun and Default
	     Knife in Currents are never offered.

	Both scripts need the same ROOM. The two clients meet on the same small relay
	the ServerChat script uses, with the same logic: the channel name is worked
	out from this server's JobId, so only clients in THIS server hear each other,
	and the channel is read back through its /json?poll=1&since=<id> cursor, so
	nothing old is replayed. That is what says CONNECTED on both sides. Every
	step above is timed off the trade window and the clock, so a slow, busy or
	dead relay cannot delay or block a trade.
	Set CONFIG.TARGET to a username to trade with that person instead of whoever
	else is in this server.
]]

--------------------------------------------------------------------------
-- Configuration
--------------------------------------------------------------------------

local CONFIG = {
	-- Both scripts must use the same room code. Change it to a private code.
	ROOM = "fbshare1",

	-- Message relay. ntfy.sh needs no signup.
	RELAY_URL = "https://ntfy.sh",

	-- The trade starts as soon as the link says the other script is here (that
	-- takes a fraction of a second). This is only a short settle on top of it.
	TRADE_START_DELAY_SECONDS = 0.5,

	-- If the relay never answers but the other person is standing in this
	-- server, the trade still starts after this many seconds. Nothing about the
	-- trade depends on the relay.
	LINK_FALLBACK_SECONDS = 4,

	-- The handshake, all in seconds:
	--   request out --1s--> joiner accepts the request and says so
	--   accepted    --REQUEST_SETTLE_SECONDS--> start adding items
	--   last item   --ACCEPT_DELAY_SECONDS--> this side presses accept, and at
	--                that same moment tells the joiner to press accept
	--   told        --JOINER_ACCEPT_DELAY_SECONDS--> joiner presses accept
	--   both accept --CONFIRM_DELAY_SECONDS--> confirm
	--   confirmed   --NEXT_CYCLE_DELAY_SECONDS--> next request, no dead time
	REQUEST_SETTLE_SECONDS = 2,
	ACCEPT_DELAY_SECONDS = 6,
	JOINER_ACCEPT_DELAY_SECONDS = 1,
	CONFIRM_DELAY_SECONDS = 1,
	NEXT_CYCLE_DELAY_SECONDS = 0.5,
	ITEM_OFFER_GAP_SECONDS = 0.3,

	-- The link: the same transport the ServerChat script uses. The channel name
	-- comes from this server's JobId, so only clients in THIS server hear each
	-- other. ntfy.sh allows 60 requests as a burst, then about one per 10s.
	LINK_POLL_SECONDS = 10,        -- how often the channel is read
	LINK_START_POLL_SECONDS = 1.5,   -- during the first moments: fast, so CONNECTED happens at once
	LINK_START_POLL_WINDOW = 20,   -- how long that fast pace lasts
	LINK_MAX_POLL_SECONDS = 25,    -- the most it backs off to while the relay refuses
	LINK_HELLO_SECONDS = 12,       -- how often to say hello until the other script answers
	LINK_HELLO_RETRY_SECONDS = 4,  -- a refused hello is retried this soon
	LINK_KEEPALIVE_SECONDS = 60,   -- how often after that

	-- The game refuses a new request while a trade is open and for a moment
	-- after one, so a failed request is retried instead of ending the loop.
	REQUEST_ATTEMPTS = 8,
	REQUEST_RETRY_SECONDS = 1,

	-- How long to wait for the joiner to accept before the request is resent.
	REQUEST_ACK_SECONDS = 6,

	-- Firing the accept signal is not proof the game took it, so the press is
	-- checked and repeated until the window changes. These are the same values
	-- the joiner uses to press its own accept.
	ACCEPT_PRESS_ATTEMPTS = 3,
	ACCEPT_PRESS_CHECK_SECONDS = 0.8,
	ACCEPT_PRESS_RETRY_SECONDS = 1.2,

	-- After a confirm, how long to wait before re-reading the salvage to check
	-- that the items really left the inventory.
	TRADE_SETTLE_SECONDS = 0.5,

	-- How many cycles in a row may trade nothing before the loop gives up and
	-- says why, instead of pretending to work.
	MAX_EMPTY_CYCLES = 3,

	-- After a confirm, how long the next request waits for this client's trade
	-- window to disappear. The game refuses a new request while one is open.
	TRADE_CLOSE_SECONDS = 1.5,

	-- How many items go into one trade.
	MAX_ITEMS_PER_TRADE = 4,

	-- The only things that are never traded: the Default Gun and the Default
	-- Knife, and only while they sit in the Currents tab. Every other item is
	-- traded away - the rest of Currents, and all of Events and Classic.
	KEEP_TAB = "Current",
	KEEP_ITEM_NAMES = { "default gun", "default knife" },

	-- "Everything is traded" is only believed after the salvage list and every
	-- tab have been read this many times in a row and shown nothing tradable.
	DONE_CONFIRM_ATTEMPTS = 4,
	DONE_CONFIRM_GAP_SECONDS = 4,

	-- Reads that come back with nothing at all (the game rebuilding the list)
	-- are not proof of anything. Keep re-reading this many times, this far
	-- apart, before saying the check could not be confirmed.
	EMPTY_READ_ATTEMPTS = 15,
	EMPTY_READ_GAP_SECONDS = 3,

	-- Set to a Roblox username to trade with that person instead of whoever else
	-- is in this server.
	TARGET = "",
}

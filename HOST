--[[
	Server Share - HOST (with automatic trade)

	Run this in the Roblox server you want someone to join.

	What it does
	  1. Publishes this server's PlaceId / JobId plus your own name to a tiny
	     public relay (ntfy.sh), so joiner.lua can find and teleport here.
	  2. Listens on a second topic ("<server topic>_players") where the joiner
	     announces itself. That is how this script learns the joiner's username
	     before the joiner has even finished loading in. It also answers the
	     joiner's "is anybody hosting?" ping there, but only while it really is
	     free to host, so a finished host cannot attract anyone.
	  3. Watches the actual Players list until that username is really in this
	     server, waits CONFIG.TRADE_START_DELAY_SECONDS (5 s), sends it a trade
	     request and only adds its up to four items once the joiner has
	     confirmed its trade window is open. Both clients press accept 6 s after
	     the items are in. A refused request is retried instead of ending the
	     loop, and a trade that moves nothing is noticed and retried. It repeats
	     until nothing tradable is left. The Default Gun and Default Knife in the
	     Currents tab are never traded; Events and Classic items always are.

	The timing and the accept/confirm handshake travel over a third topic
	("<server topic>_sync"), so host and joiner wait for each other instead of
	only guessing from timers. The joiner's half lives in joiner.lua.

	The card in the corner shows the host name, the job id and the joiner, and
	has a Stop button, so the person running this stays in control.

	Read the notes next to this file for setup and limits.
]]

--------------------------------------------------------------------------
-- Configuration
--------------------------------------------------------------------------

local CONFIG = {
	-- Both scripts must use the same room code. Change it to a private code.
	ROOM = "fbshare1",

	-- Message relay. ntfy.sh needs no signup.
	RELAY_URL = "https://ntfy.sh",

	-- Republish this often even if nothing changed, so the joiner can tell the
	-- info is fresh. ntfy.sh allows 250 messages/day; 10 minutes stays under it.
	HEARTBEAT_SECONDS = 600,

	-- How often to notice that the server changed (e.g. after a game teleport).
	CHECK_SECONDS = 3,

	-- Seconds before retrying after a failed publish.
	RETRY_SECONDS = 20,

	-- How often to check the joiner topic for a new announcement.
	PRESENCE_POLL_SECONDS = 4,

	-- Only announcements published within this many minutes are read at all.
	PRESENCE_MAX_AGE_MINUTES = 30,

	-- A joiner announces itself right before it teleports, so an announcement
	-- older than this belongs to somebody who is not coming any more. Without
	-- this, an old announcement for this server (from a previous run) made the
	-- host believe a joiner was on the way and stop answering pings forever.
	JOINER_ANNOUNCE_MAX_AGE_SECONDS = 300,

	-- If the announced joiner never shows up in the Players list, stop waiting
	-- for them, so the host is available again for the next real joiner.
	JOINER_ARRIVAL_TIMEOUT_SECONDS = 90,

	-- Seconds between "the joiner is definitely in this server" and the first
	-- trade request going out. This is the 5 second delay.
	TRADE_START_DELAY_SECONDS = 5,

	-- true  -> the trade loop starts by itself after TRADE_START_DELAY_SECONDS.
	-- false -> you press "Run trade" yourself once the joiner is in.
	TRADE_ON_DETECT = true,

	-- The handshake, all in seconds:
	--   request out --1s--> joiner accepts and says so
	--   accepted    --REQUEST_SETTLE_SECONDS--> start adding items
	--   last item   --ACCEPT_DELAY_SECONDS--> both sides press accept
	--   accept      --CONFIRM_DELAY_SECONDS--> confirm
	--   confirmed   --NEXT_CYCLE_DELAY_SECONDS--> next request, no dead time
	REQUEST_SETTLE_SECONDS = 2,
	ACCEPT_DELAY_SECONDS = 6,
	CONFIRM_DELAY_SECONDS = 1,
	NEXT_CYCLE_DELAY_SECONDS = 0.5,
	ITEM_OFFER_GAP_SECONDS = 0.3,

	-- How long to wait for the other side's event on the sync topic.
	ACK_WAIT_SECONDS = 15,

	-- How often the sync topic is read while a trade is running.
	SYNC_POLL_SECONDS = 2,

	-- Liveness handshake. A joiner that is looking for a host publishes a ping
	-- on the joiner topic; this script answers it only while it really is
	-- hosting. That way an old announcement from a server that is long gone (or
	-- from this very client) can never attract anyone.
	PING_ACK_SECONDS = 6,      -- minimum gap between two answers
	PING_MAX_AGE_SECONDS = 120, -- ignore pings older than this

	-- The game refuses a new request while a trade is open and for a moment
	-- after one, so a failed request is retried instead of ending the loop.
	REQUEST_ATTEMPTS = 8,
	REQUEST_RETRY_SECONDS = 1,

	-- How long to wait for the joiner to accept before the request is resent.
	REQUEST_ACK_SECONDS = 6,

	-- Firing the accept signal is not proof the game took it, so the press is
	-- checked and repeated until the window changes.
	ACCEPT_PRESS_ATTEMPTS = 3,
	ACCEPT_PRESS_CHECK_SECONDS = 0.6,
	ACCEPT_PRESS_RETRY_SECONDS = 1,

	-- After a confirm, how long to wait before re-reading the salvage to check
	-- that the items really left the inventory.
	TRADE_SETTLE_SECONDS = 0.5,

	-- How many cycles in a row may trade nothing before the loop gives up and
	-- says why, instead of pretending to work.
	MAX_EMPTY_CYCLES = 3,

	-- After a confirm, how long the next request waits for this client's trade
	-- window to disappear. The game refuses a new request while one is open.
	TRADE_CLOSE_SECONDS = 1.5,

	-- How many items go into one trade.
	MAX_ITEMS_PER_TRADE = 4,

	-- The only things that are never traded: the Default Gun and the Default
	-- Knife, and only while they sit in the Currents tab. Every other item is
	-- traded away - the rest of Currents, and all of Events and Classic.
	KEEP_TAB = "Current",
	KEEP_ITEM_NAMES = { "default gun", "default knife" },

	-- "Everything is traded" is only believed after the salvage list and every
	-- tab have been read this many times in a row and shown nothing tradable.
	DONE_CONFIRM_ATTEMPTS = 4,
	DONE_CONFIRM_GAP_SECONDS = 4,

	-- Reads that come back with nothing at all (the game rebuilding the list)
	-- are not proof of anything. Keep re-reading this many times, this far
	-- apart, before saying the check could not be confirmed.
	EMPTY_READ_ATTEMPTS = 15,
	EMPTY_READ_GAP_SECONDS = 3,
}

--------------------------------------------------------------------------
-- Services and small helpers
--------------------------------------------------------------------------

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local localPlayer = Players.LocalPlayer

local function waitSeconds(seconds)
	if task and task.wait then
		return task.wait(seconds)
	end
	return wait(seconds)
end

local function spawnThread(fn)
	if task and task.spawn then
		return task.spawn(fn)
	end
	return spawn(fn)
end

-- Wall clock in seconds, used for the countdown.
local function nowSeconds()
	if type(tick) == "function" then
		return tick()
	end
	return os.clock()
end

local function safeField(container, key)
	if container == nil then
		return nil
	end
	if type(container) ~= "table" and typeof(container) ~= "Instance" and type(container) ~= "userdata" then
		return nil
	end
	local ok, value = pcall(function()
		return container[key]
	end)
	if ok then
		return value
	end
	return nil
end

-- Removes control characters, separators and runs of spaces, so a name can
-- never break the wire format or the layout.
local function cleanText(text, maxLength)
	if type(text) ~= "string" then
		return ""
	end
	text = text:gsub("[%c]", " ")
	text = text:gsub("|", "/")
	text = text:gsub("%s+", " ")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if maxLength and #text > maxLength then
		text = text:sub(1, maxLength - 1) .. "..."
	end
	return text
end

local function toHex(text)
	return (tostring(text):gsub(".", function(char)
		return string.format("%02x", string.byte(char))
	end))
end

--------------------------------------------------------------------------
-- HTTP bridge (executors expose this under different names)
--------------------------------------------------------------------------

local function urlEncode(value)
	return (tostring(value):gsub("[^%w%-%._~]", function(char)
		return string.format("%%%02X", string.byte(char))
	end))
end

local httpRequest
for _, candidate in ipairs({
	safeField(syn, "request"),
	safeField(http, "request"),
	safeField(fluxus, "request"),
	safeField(krnl, "request"),
	rawget(_G, "http_request"),
	rawget(_G, "request"),
}) do
	if type(candidate) == "function" then
		httpRequest = candidate
		break
	end
end

-- Returns: ok (boolean, HTTP 2xx), status code, body
local function http(url, method, body, headers)
	if httpRequest then
		local sent, response = pcall(httpRequest, {
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})
		if not sent then
			return false, 0, tostring(response)
		end
		if type(response) == "string" then
			-- Older shims hand back the body directly.
			return true, 200, response
		end
		if type(response) ~= "table" then
			return false, 0, "unexpected executor response"
		end
		local status = tonumber(response.StatusCode or response.Status or response.status or response.statusCode or response.code) or 0
		local responseBody = response.Body or response.body or ""
		if type(responseBody) ~= "string" then
			responseBody = tostring(responseBody)
		end
		return status >= 200 and status < 300, status, responseBody
	end

	-- Fallback for executors that only shim game:HttpGet (GET requests only).
	if method == nil or method == "GET" then
		local ok, response = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(response) == "string" then
			return true, 200, response
		end
		return false, 0, tostring(response)
	end

	return false, 0, "this executor does not support HTTP requests"
end

local httpAvailable = httpRequest ~= nil
if not httpAvailable then
	local ok, getter = pcall(function()
		return game.HttpGet
	end)
	httpAvailable = ok and type(getter) == "function"
end

--------------------------------------------------------------------------
-- Room / wire format
--------------------------------------------------------------------------

local WIRE_VERSION = "v2"        -- what this script publishes
local PRESENCE_VERSION = "j1"    -- what joiner.lua publishes

local function sanitizeRoom(raw)
	local cleaned = tostring(raw or ""):lower():gsub("[^%w_%-]", "")
	if #cleaned > 48 then
		cleaned = cleaned:sub(1, 48)
	end
	if cleaned == "" then
		cleaned = "main"
	end
	return cleaned
end

local room = sanitizeRoom(CONFIG.ROOM)
local topic = "fbshare_" .. room
local presenceTopic = topic .. "_players"
local relayBase = tostring(CONFIG.RELAY_URL):gsub("/+$", "")

-- v2|placeId|jobId|username|displayName|gameName|timestamp
local function encodeInfo(place, job, username, displayName, gameName, timestamp)
	return table.concat({
		WIRE_VERSION,
		tostring(place),
		cleanText(tostring(job), 100),
		cleanText(tostring(username), 40),
		cleanText(tostring(displayName), 40),
		cleanText(tostring(gameName), 60),
		tostring(timestamp),
	}, "|")
end

-- j1|placeId|jobId|username|displayName|timestamp
local function decodePresence(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 6 or parts[1] ~= PRESENCE_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local job = parts[3]
	local stamp = tonumber(parts[6])
	local username = cleanText(parts[4], 40)

	if not place or place <= 0 or math.floor(place) ~= place then
		return nil
	end
	if type(job) ~= "string" or #job < 6 or #job > 100 or job:find("[^%w%-_%.]") then
		return nil
	end
	if not stamp then
		return nil
	end
	-- The joiner topic is public, so only accept something that looks like a
	-- real Roblox username before it can ever become a trade target.
	if username == "" or #username > 25 or username:find("[^%w_]") then
		return nil
	end

	return {
		place = place,
		job = job,
		username = username,
		display = cleanText(parts[5], 40),
		stamp = stamp,
	}
end

-- q1|placeId|username|timestamp
--
-- A joiner that has not found a host yet puts one of these on the joiner
-- topic, asking "is anybody actually hosting right now?". It is deliberately
-- a different version string from a joiner announcement, so it can never be
-- mistaken for somebody who is coming to this server.
local QUERY_VERSION = "q1"

local function decodeQuery(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 4 or parts[1] ~= QUERY_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local stamp = tonumber(parts[4])
	local username = cleanText(parts[3], 40)

	if not place or place <= 0 or not stamp then
		return nil
	end
	if username == "" or #username > 25 or username:find("[^%w_]") then
		return nil
	end

	return {
		place = place,
		username = username,
		stamp = stamp,
	}
end

-- h1|placeId|jobId|username|displayName|gameName|timestamp
--
-- The answer to a ping: "a host is running here, right now, in this job".
-- Decoded by joiner.lua before it follows anybody.
local ACK_VERSION = "h1"

local function encodeAck(place, job, username, displayName, gameName, timestamp)
	return table.concat({
		ACK_VERSION,
		tostring(place),
		cleanText(tostring(job), 100),
		cleanText(tostring(username), 40),
		cleanText(tostring(displayName), 40),
		cleanText(tostring(gameName), 60),
		tostring(timestamp),
	}, "|")
end

local function relayPublishTo(topicName, text)
	if httpRequest then
		local ok, status, body = http(relayBase .. "/" .. topicName, "POST", text, {
			["Content-Type"] = "text/plain",
		})
		return ok, status, body
	end
	-- GET publish, for the game:HttpGet-only fallback.
	local ok, status, body = http(relayBase .. "/" .. topicName .. "/publish?message=" .. urlEncode(text), "GET")
	return ok, status, body
end

local function relayPublish(text)
	return relayPublishTo(topic, text)
end

local function currentJobId()
	local ok, job = pcall(function()
		return game.JobId
	end)
	if ok and type(job) == "string" then
		return job
	end
	return ""
end

--------------------------------------------------------------------------
-- Talking to the joiner while the trade runs
--
-- A third topic, "<server topic>_sync", carries what each side just did: the
-- request went out, the items are in, accept was pressed. Both scripts wait
-- for the other side's event instead of only guessing from a timer, and every
-- event names the host and the joiner it belongs to, so two pairs sharing a
-- room never react to each other's messages.
--------------------------------------------------------------------------

local syncTopic = topic .. "_sync"
local SYNC_VERSION = "s1"

-- Filled in further down. The trade code is defined before the UI and the
-- state table, so it needs the names up front and assigns to them there.
local ui, state, setStatus, updateInfo, THEME

local function relayReadTopic(topicName, minutes)
	local url = relayBase .. "/" .. topicName .. "/raw?poll=1&since=" .. tostring(minutes) .. "m"
	return http(url, "GET")
end

-- s1|event|placeId|jobId|cycle|payload|hostUsername|joinerUsername|timestamp
local function encodeSync(event, joinerUsername, cycle, payload)
	return table.concat({
		SYNC_VERSION,
		cleanText(tostring(event), 16),
		tostring(tonumber(game.PlaceId) or 0),
		cleanText(currentJobId(), 100),
		tostring(tonumber(cycle) or 0),
		cleanText(tostring(payload or ""), 60),
		cleanText(tostring(localPlayer.Name or ""), 40),
		cleanText(tostring(joinerUsername or ""), 40),
		tostring(os.time()),
	}, "|")
end

local function decodeSync(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 9 or parts[1] ~= SYNC_VERSION then
		return nil
	end

	local place = tonumber(parts[3])
	local job = parts[4]
	local cycle = tonumber(parts[5])
	local stamp = tonumber(parts[9])

	if not place or place <= 0 then
		return nil
	end
	if type(job) ~= "string" or #job < 6 or #job > 100 or job:find("[^%w%-_%.]") then
		return nil
	end
	if not cycle or not stamp then
		return nil
	end

	return {
		event = cleanText(parts[2], 16),
		place = place,
		job = job,
		cycle = cycle,
		payload = cleanText(parts[6], 60),
		host = cleanText(parts[7], 40),
		joiner = cleanText(parts[8], 40),
		stamp = stamp,
	}
end

-- The relay can rate limit (ntfy's free relay allows only so many requests a
-- minute). While it is down the fixed timings still drive the trade, so the
-- waits for the joiner's word are shortened rather than stalling every cycle.
local syncTrouble = 0

local function noteSync(ok)
	if ok then
		syncTrouble = 0
	else
		syncTrouble = syncTrouble + 1
	end
end

local function publishSync(event, joinerUsername, cycle, payload)
	local ok, status = relayPublishTo(syncTopic, encodeSync(event, joinerUsername, cycle, payload))
	noteSync(ok)
	if not ok then
		print("[Trade] could not publish '" .. tostring(event) .. "' (error " .. tostring(status) .. ")")
	end
	return ok
end

--------------------------------------------------------------------------
-- The joiner's side of the conversation
--------------------------------------------------------------------------

local sync = {
	started = false,
	busy = false,
	events = {},
}

local function recordSync(entry)
	local current = sync.events[entry.event]
	if current == nil or entry.cycle >= current.cycle then
		sync.events[entry.event] = entry
	end
end

local function pollSync(myJob, joinerUsername)
	if sync.busy then
		return
	end
	sync.busy = true
	local ok, status, body = relayReadTopic(syncTopic, 10)
	sync.busy = false

	if not ok then
		noteSync(false)
		if status == 429 then
			waitSeconds(5)
		end
		return
	end
	noteSync(true)

	local myPlace = tonumber(game.PlaceId) or 0
	local wantedHost = tostring(localPlayer.Name or ""):lower()
	local wantedJoiner = tostring(joinerUsername):lower()
	local seen = {}

	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeSync(line)
		if entry
			and entry.place == myPlace
			and entry.job == myJob
			and entry.host:lower() == wantedHost
			and entry.joiner:lower() == wantedJoiner
		then
			local key = entry.event .. "#" .. tostring(entry.stamp)
			if not seen[key] then
				seen[key] = true
				recordSync(entry)
			end
		end
	end
end

local function startSyncPolling(joinerUsername)
	if sync.started then
		return
	end
	sync.started = true
	local myJob = currentJobId()
	spawnThread(function()
		while state ~= nil and state.running do
			pollSync(myJob, joinerUsername)
			waitSeconds(CONFIG.SYNC_POLL_SECONDS)
		end
	end)
end

-- Waits until the joiner has reported `event` for `cycle`. Returns whether it
-- arrived, and the payload that came with it ("ok", "nowindow", ...).
local function waitForSync(event, cycle, timeoutSeconds)
	-- With the relay silent, waiting the full time only delays the trade.
	if syncTrouble >= 3 and timeoutSeconds > 3 then
		timeoutSeconds = 3
	end
	local deadline = nowSeconds() + timeoutSeconds
	while state ~= nil and state.running do
		local entry = sync.events[event]
		if entry ~= nil and entry.cycle >= cycle then
			return true, entry.payload
		end
		if nowSeconds() >= deadline then
			return false, nil
		end
		waitSeconds(0.25)
	end
	return false, nil
end

--------------------------------------------------------------------------
-- Trade actions on this client
--------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local function tradeGui()
	local gui = localPlayer:FindFirstChild("PlayerGui")
	if gui == nil then
		return nil
	end
	return gui:FindFirstChild("TradeGUI")
end

-- Fires each button signal once: Activated and MouseButton1Click, the same
-- way the trade script this was based on presses the button. Nothing is fired
-- twice and the window itself is never touched (no hiding, no disabling).
local PRESS_SIGNALS = { "Activated", "MouseButton1Click" }

local function fireButton(button)
	if button == nil then
		return false
	end
	local fired = {}
	for _, name in ipairs(PRESS_SIGNALS) do
		local signal = nil
		pcall(function()
			signal = button[name]
		end)
		if signal ~= nil then
			local ok = false
			if type(firesignal) == "function" then
				ok = pcall(firesignal, signal)
			else
				ok = pcall(function()
					signal:Fire()
				end)
			end
			if ok then
				fired[#fired + 1] = name
			end
		end
	end
	if #fired == 0 then
		return false
	end
	return true, table.concat(fired, "+")
end

-- If the game switched this client's trade window off, switch it back on.
-- Nothing in either script ever switches it off.
local function ensureTradeWindowShown(gui)
	if gui == nil then
		return
	end
	pcall(function()
		if gui.Enabled ~= true then
			gui.Enabled = true
			print("[Trade] the trade window had been switched off (Enabled = false) - switched it back on")
		end
	end)
end

-- What the trade window's two buttons look like right now, so "the press
-- landed" can be told apart from "the signal fired and the game ignored it".
local function windowSignature()
	local gui = tradeGui()
	if gui == nil then
		return nil
	end
	local parts = {}
	local function add(label, getter)
		pcall(function()
			local button = getter()
			local text = "?"
			local colour = "?"
			local visible = "?"
			local active = "?"
			pcall(function()
				text = tostring(button.Text)
			end)
			pcall(function()
				local c = button.BackgroundColor3
				colour = string.format("%.2f,%.2f,%.2f", c.R, c.G, c.B)
			end)
			pcall(function()
				visible = tostring(button.Visible)
			end)
			pcall(function()
				active = tostring(button.Active)
			end)
			parts[#parts + 1] = string.format("%s[%s %s %s %s]", label, text, colour, visible, active)
		end)
	end
	add("accept", function()
		return gui.Container.Trade.Actions.Accept.ActionButton
	end)
	add("confirm", function()
		return gui.Container.Trade.Actions.Accept.Confirm.ActionButton
	end)
	return table.concat(parts, " ")
end

-- Presses accept and keeps pressing until the game shows it took it. Firing the
-- signal is not accepting: a press that lands before the items are in, or into
-- a window the game is still preparing, is ignored - which is how a client ends
-- up having agreed to the request but not to the items.
local function pressAccept()
	local before = windowSignature()
	local lastError = "the trade window is not open"
	for attempt = 1, CONFIG.ACCEPT_PRESS_ATTEMPTS do
		local gui = tradeGui()
		if gui == nil then
			return false, lastError
		end
		ensureTradeWindowShown(gui)
		local button = nil
		pcall(function()
			button = gui.Container.Trade.Actions.Accept.ActionButton
		end)
		if button ~= nil then
			local ok, signalName = fireButton(button)
			if ok then
				waitSeconds(CONFIG.ACCEPT_PRESS_CHECK_SECONDS)
				if tradeGui() == nil then
					print("[Trade] the trade window closed after the accept press")
					return true, signalName
				end
				local after = windowSignature()
				if after ~= nil and after ~= before then
					print("[Trade] the game took the accept (" .. tostring(after) .. ")")
					return true, signalName
				end
				lastError = "the game never showed the accept"
				print(string.format(
					"[Trade] accept attempt %d did not register - pressing again",
					attempt
				))
			else
				lastError = "no signal could be fired on the accept button"
			end
		else
			lastError = "the accept button could not be found"
		end
		if attempt < CONFIG.ACCEPT_PRESS_ATTEMPTS then
			waitSeconds(CONFIG.ACCEPT_PRESS_RETRY_SECONDS)
		end
	end
	return false, lastError
end

local function pressConfirm()
	local gui = tradeGui()
	if gui == nil then
		return false, "the trade window is not open"
	end
	ensureTradeWindowShown(gui)
	local button = nil
	pcall(function()
		button = gui.Container.Trade.Actions.Accept.Confirm.ActionButton
	end)
	if button == nil then
		return false, "the confirm button could not be found"
	end
	local ok, signalName = fireButton(button)
	return ok, signalName
end

local function tradeRemote(name)
	local ok, remote = pcall(function()
		local container = ReplicatedStorage:WaitForChild("Trade", 10)
		if container == nil then
			return nil
		end
		return container:WaitForChild(name, 10)
	end)
	if ok then
		return remote
	end
	return nil
end

local function sendTradeRequest(targetPlayer)
	local remote = tradeRemote("SendRequest")
	if remote == nil then
		return false, "Trade.SendRequest could not be found"
	end
	local ok, err = pcall(function()
		remote:InvokeServer(targetPlayer)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true
end

local function offerItem(itemName)
	local remote = tradeRemote("OfferItem")
	if remote == nil then
		return false
	end
	return pcall(function()
		remote:FireServer(itemName, "Weapons")
	end)
end

--------------------------------------------------------------------------
-- Reading the salvage / inventory
--
-- Same tiers and same stack expansion as your trade script, but every weapons
-- tab is discovered rather than listed, item cards are found by their label
-- (the game does not name them the same way in every tab), and the only items
-- left alone are the Default Gun and Default Knife while they sit in Currents.
--------------------------------------------------------------------------

local tradePaths = nil
-- How many items were skipped as "keep" by the last read (Default Gun / Knife).
local lastKeptCount = 0
-- The names that were left alone by the last read.
local lastKeptNames = {}
-- Names already explained in the console, so the note is printed once.
local sharedNoted = {}

-- Lowercase, letters and digits only: "Default_Knife_ab12" and "Default Knife"
-- then compare the way a player would read them.
local function normalizeName(text)
	local lowered = tostring(text or ""):lower()
	return (lowered:gsub("[^%w]", ""))
end

local KEEP_KEYS = {}
for _, name in ipairs(CONFIG.KEEP_ITEM_NAMES) do
	KEEP_KEYS[#KEEP_KEYS + 1] = normalizeName(name)
end

-- True when a name is one of the two defaults. `lenient` also accepts a suffix
-- ("Default_Knife_ab12" from the salvage list); the strict form is used for
-- inventory cards, so a skin called "Default Gun Gold" is still traded.
local function isKeepKey(key, lenient)
	if key == nil or key == "" then
		return false
	end
	for _, keep in ipairs(KEEP_KEYS) do
		if key == keep then
			return true
		end
		if lenient and #key > #keep and key:sub(1, #keep) == keep then
			return true
		end
		if not lenient and #key > #keep and key:sub(1, #keep) == keep then
			local rest = key:sub(#keep + 1)
			if rest:match("^%d+$") then
				return true
			end
		end
	end
	return false
end

-- The tab an item sits in decides whether the keep rule applies at all: a
-- Default Gun in Events or Classic is still traded away.
local function tabMatchesKeepTab(tab)
	if tab == nil then
		-- Unknown tab: leave the default behind rather than trade it by accident.
		return true
	end
	local name = tostring(tab)
	if name == CONFIG.KEEP_TAB then
		return true
	end
	return name:sub(1, #CONFIG.KEEP_TAB + 1) == CONFIG.KEEP_TAB .. "/"
end

local function isKeptItem(data)
	if data == nil then
		return false
	end
	if not isKeepKey(data.key, false) then
		return false
	end
	return tabMatchesKeepTab(data.tab)
end

-- A child that may not exist, without ever hanging on it.
local function childOf(parent, name, timeout)
	if parent == nil then
		return nil
	end
	local ok, found = pcall(function()
		return parent:FindFirstChild(name) or parent:WaitForChild(name, timeout or 2)
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- The same, but without waiting: used while walking a list that is expected to
-- be there already, where waiting on every label would add up to minutes.
local function findChild(parent, name)
	if parent == nil then
		return nil
	end
	local ok, found = pcall(function()
		return parent:FindFirstChild(name)
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

local function tradeRoots()
	local ok, roots = pcall(function()
		local gui = childOf(localPlayer, "PlayerGui", 10)
		local main = childOf(gui, "MainGUI", 20)
		local gameGui = childOf(main, "Game", 20)
		return gameGui
	end)
	if ok and typeof(roots) == "Instance" then
		return roots
	end
	return nil
end

-- Every weapons tab under Items.Container, whatever it is called. Current and
-- Classic are found this way, and so is the Events group (Holiday ->
-- Halloween, Christmas, ...): a tab the script has never heard of is still read
-- and its items still traded.
local function collectTabs(parent, prefix, list, depth)
	if parent == nil or depth > 3 then
		return
	end
	local ok, children = pcall(function()
		return parent:GetChildren()
	end)
	if not ok or children == nil then
		return
	end
	for _, node in ipairs(children) do
		if node ~= nil and typeof(node) == "Instance" then
			-- Item cards also have a Container child (the stack amount), so they
			-- are told apart by the ItemName label that only cards carry.
			if findChild(node, "ItemName") == nil then
				local tabName = prefix ~= "" and (prefix .. "/" .. tostring(node.Name)) or tostring(node.Name)
				local container = findChild(node, "Container")
				if container ~= nil then
					list[#list + 1] = { tab = tabName, node = container }
				end
				collectTabs(node, tabName, list, depth + 1)
			end
		end
	end
end

local function salvageContainer(gameGui)
	local crafting = childOf(gameGui, "Crafting", 15)
	local inventory = childOf(crafting, "Inventory", 10) or crafting
	local salvage = childOf(inventory, "Salvage", 10)
	if salvage == nil then
		local ok, found = pcall(function()
			return gameGui:FindFirstChild("Salvage", true)
		end)
		if ok and typeof(found) == "Instance" then
			salvage = found
		end
	end
	if salvage == nil then
		return nil
	end
	local scroll = childOf(salvage, "ScrollFrame", 3)
	local container = childOf(scroll or salvage, "Container", 3)
	return container or scroll or salvage
end

-- The three nodes every read needs: the Game gui, the tab holder and the
-- salvage list. Cached, and re-found when a node the game rebuilt goes away.
local function resolveTradePaths()
	if tradePaths ~= nil then
		local alive = false
		pcall(function()
			alive = tradePaths.game.Parent ~= nil
				and tradePaths.tabHolder.Parent ~= nil
				and tradePaths.salvage.Parent ~= nil
		end)
		if alive then
			return tradePaths
		end
		tradePaths = nil
	end

	local gameGui = tradeRoots()
	if gameGui == nil then
		return nil
	end
	local inventoryGui = childOf(gameGui, "Inventory", 15)
	local main = inventoryGui and childOf(inventoryGui, "Main", 10)
	local weapons = main and childOf(main, "Weapons", 10)
	local itemsNode = weapons and childOf(weapons, "Items", 10)
	local tabHolder = itemsNode and childOf(itemsNode, "Container", 10)
	if tabHolder == nil then
		return nil
	end
	local salvage = salvageContainer(gameGui)
	if salvage == nil then
		return nil
	end

	tradePaths = { game = gameGui, tabHolder = tabHolder, salvage = salvage }
	return tradePaths
end

-- The longest inventory name that fits a salvage frame name. The old version
-- compared first words, which made every "Default_*" frame match "Default Gun";
-- the longest fit cannot do that, so similarly named items keep their own tab.
local function matchItem(frameName, index, cards)
	local key = normalizeName(frameName)
	if key == "" then
		return nil
	end
	local exact = index[key]
	if exact ~= nil then
		return exact
	end
	local best, bestLen = nil, 0
	for _, data in ipairs(cards) do
		local candidate = data.key
		if #candidate >= 4 then
			if key:sub(1, #candidate) == candidate then
				if #candidate > bestLen then
					best, bestLen = data, #candidate
				end
			elseif #key >= 4 and candidate:sub(1, #key) == key and #key > bestLen then
				best, bestLen = data, #key
			end
		end
	end
	return best
end

local function shuffleTable(list)
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
end

pcall(function()
	math.randomseed(tick())
end)

local function getFreshWeaponQueue()
	local paths = resolveTradePaths()
	if paths == nil then
		return nil, nil
	end

	local tabs = {}
	collectTabs(paths.tabHolder, "", tabs, 0)

	local cards = {}
	local index = {}
	local shared = {}

	for _, tab in ipairs(tabs) do
		local ok, children = pcall(function()
			return tab.node:GetChildren()
		end)
		if ok and children ~= nil then
			for _, card in ipairs(children) do
				-- Cards are found by their label, not by name: the game does not
				-- use the same name for every card in every tab.
				local itemName = findChild(card, "ItemName")
				local label = itemName and findChild(itemName, "Label")
				if label ~= nil and label:IsA("TextLabel") then
					local text = tostring(label.Text)
					local key = normalizeName(text)
					if key ~= "" then
						local amount = 1
						local cardContainer = findChild(card, "Container")
						local amountObject = cardContainer and findChild(cardContainer, "Amount")
						if amountObject ~= nil then
							local digits = tostring(amountObject.Text or ""):match("%d+")
							amount = tonumber(digits) or 1
						end
						local data = {
							label = text,
							key = key,
							tab = tab.tab,
							amount = math.max(1, amount),
						}
						pcall(function()
							data.color = itemName.BackgroundColor3
						end)
						cards[#cards + 1] = data
						local existing = index[key]
						if existing == nil then
							index[key] = data
						else
							shared[key] = true
							-- The Currents entry wins, because that is the tab the
							-- Default Gun and Default Knife live in.
							if existing.tab ~= CONFIG.KEEP_TAB and tab.tab == CONFIG.KEEP_TAB then
								index[key] = data
							end
						end
					end
				end
			end
		end
	end

	-- Said once, not on every read: the same note twenty times helps nobody.
	for key in pairs(shared) do
		if isKeepKey(key, false) and not sharedNoted[key] then
			sharedNoted[key] = true
			local label = index[key] and index[key].label or key
			print("[Trade] note: '" .. tostring(label) .. "' also exists in another tab; treating it as the Currents one")
		end
	end

	local okSalvage, salvageChildren = pcall(function()
		return paths.salvage:GetChildren()
	end)
	if not okSalvage or salvageChildren == nil then
		return nil, nil
	end

	local tier1, tier2, tier3 = {}, {}, {} -- 1: RGB(100,10,255)  2: RGB(255,0,179)  3: the rest
	local kept, keptNames = 0, {}
	local matched = {}

	for _, frame in ipairs(salvageChildren) do
		local frameName = tostring(frame.Name)
		local data = matchItem(frameName, index, cards)
		if data ~= nil then
			matched[data.key] = true
		end

		-- Kept: the Default Gun and Default Knife, in Currents. A frame the tabs
		-- do not explain falls back to its own name, so a default that is not in
		-- any tab is still never offered.
		if isKeptItem(data) or (data == nil and isKeepKey(normalizeName(frameName), true)) then
			kept = kept + (data and data.amount or 1)
			keptNames[data and data.label or frameName] = true
		else
			local entry = { frameName = frameName, amount = data and data.amount or 1 }
			local tier = tier3
			if data ~= nil and data.color ~= nil then
				local r = math.floor(data.color.R * 255 + 0.5)
				local g = math.floor(data.color.G * 255 + 0.5)
				local b = math.floor(data.color.B * 255 + 0.5)
				if r == 100 and g == 10 and b == 255 then
					tier = tier1
				elseif r == 255 and g == 0 and b == 179 then
					tier = tier2
				end
			end
			tier[#tier + 1] = entry
		end
	end

	shuffleTable(tier1)
	shuffleTable(tier2)
	shuffleTable(tier3)

	local queue = {}
	for _, tier in ipairs({ tier1, tier2, tier3 }) do
		for _, item in ipairs(tier) do
			for _ = 1, item.amount do
				queue[#queue + 1] = item.frameName
			end
		end
	end

	-- Cards the salvage list did not show. Reported rather than traded: the
	-- trade takes the salvaged name, and offering a name the trade does not know
	-- would only waste a slot.
	local unlisted, unlistedNames = 0, {}
	for _, data in ipairs(cards) do
		if not matched[data.key] and not isKeptItem(data) and unlistedNames[data.label] == nil then
			unlistedNames[data.label] = true
			unlisted = unlisted + 1
		end
	end

	lastKeptCount = kept
	lastKeptNames = keptNames
	return queue, {
		salvage = #salvageChildren,
		tradable = #queue,
		kept = kept,
		unlisted = unlisted,
		unlistedNames = unlistedNames,
		tabs = #tabs,
	}
end

local function keptNamesText(limit)
	local names = {}
	for name in pairs(lastKeptNames) do
		names[#names + 1] = tostring(name)
		if #names >= (limit or 6) then
			break
		end
	end
	if #names == 0 then
		return "none found"
	end
	return table.concat(names, ", ")
end

-- An empty salvage read is not proof that the run is over: the game rebuilds
-- that list, and a read can land while it is still filling in, which used to
-- end a run with items still in the inventory. This keeps reading until the
-- answer holds still:
--   * a tradable item shows up            -> not over, hand it back
--   * the tabs are readable and nothing
--     in them or in the salvage is
--     tradable, read the same way a few
--     times in a row                      -> confirmed finished
--   * the list keeps coming back with
--     nothing in it, or the tabs still
--     show items the salvage never lists  -> not confirmed; reported, never
--                                            claimed as "all traded".
local function waitForFinished()
	local lastInfo = nil
	local confirms = 0
	local empties = 0
	while state.running do
		local queue, info = getFreshWeaponQueue()
		if queue == nil then
			empties = empties + 1
			if empties > CONFIG.EMPTY_READ_ATTEMPTS then
				return nil, lastInfo, false
			end
			print("[Trade] the inventory could not be read - reading again")
			waitSeconds(CONFIG.EMPTY_READ_GAP_SECONDS)
		elseif #queue > 0 then
			return queue, info, false
		else
			lastInfo = info
			if info ~= nil and info.tabs > 0 and info.unlisted == 0 then
				confirms = confirms + 1
				if confirms >= CONFIG.DONE_CONFIRM_ATTEMPTS then
					return nil, info, true
				end
				waitSeconds(CONFIG.DONE_CONFIRM_GAP_SECONDS)
			else
				empties = empties + 1
				if empties > CONFIG.EMPTY_READ_ATTEMPTS then
					return nil, info, false
				end
				waitSeconds(CONFIG.EMPTY_READ_GAP_SECONDS)
			end
		end
	end
	return nil, lastInfo, false
end

--------------------------------------------------------------------------
-- The coordinated trade loop
--
--   request out (+ tell the joiner) -> 1s -> joiner accepts (+ tells the host)
--   -> 2s -> add up to 4 items (+ tell the joiner to start its 6s) -> both
--   accept -> 1s -> confirm -> 0.5s -> next request. No dead time between
--   cycles, until nothing tradable is left (the Default Gun and Default Knife
--   in Currents are never offered).
--------------------------------------------------------------------------

-- Asks for a trade and keeps trying while the game refuses. A request is
-- refused while another trade is still open and for a moment after one, which
-- used to end the whole loop on the second cycle.
local function requestTrade(targetPlayer, targetUsername, cycle)
	local lastError = nil
	for attempt = 1, CONFIG.REQUEST_ATTEMPTS do
		if not state.running then
			return false, "stopped"
		end
		if targetPlayer == nil or targetPlayer.Parent == nil then
			return false, targetUsername .. " left the server"
		end

		local ok, err = sendTradeRequest(targetPlayer)
		if ok then
			-- Tell the joiner the request is on its way, so it can accept it one
			-- second from now instead of guessing when to press.
			publishSync("req", targetUsername, cycle, tostring(attempt))
			print(string.format("[Trade] request sent to %s (attempt %d)", targetUsername, attempt))
			print("[Trade] told " .. targetUsername .. ": the request is out - accept it now")
			return true
		end

		lastError = err
		print(string.format("[Trade] request attempt %d failed: %s", attempt, tostring(err)))
		setStatus(string.format(
			"Cycle %d: the request was refused (%s). Retrying in %ds...",
			cycle,
			tostring(err),
			CONFIG.REQUEST_RETRY_SECONDS
		), THEME.amber)
		waitSeconds(CONFIG.REQUEST_RETRY_SECONDS)
	end
	return false, lastError
end

-- The game refuses a new request while a trade window is still up, so the next
-- request waits for this client's window to go away first. The cap keeps a game
-- that leaves the window instance in place from stalling the loop.
local function waitForTradeClosed(seconds)
	local deadline = nowSeconds() + seconds
	while state ~= nil and state.running and nowSeconds() < deadline do
		if tradeGui() == nil then
			return true
		end
		waitSeconds(0.25)
	end
	return tradeGui() == nil
end

local function countStillInQueue(batch, queue)
	local present = {}
	for _, name in ipairs(queue or {}) do
		local key = tostring(name):lower()
		present[key] = (present[key] or 0) + 1
	end
	local left = 0
	for _, name in ipairs(batch) do
		local key = tostring(name):lower()
		if (present[key] or 0) > 0 then
			present[key] = present[key] - 1
			left = left + 1
		end
	end
	return left
end

local function runTradeLoop(targetPlayer, targetUsername)
	if resolveTradePaths() == nil then
		error("the inventory and salvage containers could not be found")
	end

	local cycle = 0
	local traded = 0
	local emptyCycles = 0

	startSyncPolling(targetUsername)

	-- One full round trip. "ok" means the items left the inventory, "retry"
	-- means this trade did not happen at all, "stop" means the script is done.
	local function runCycle(batch)
		setStatus(string.format("Cycle %d: sending %s a trade request...", cycle, targetUsername), THEME.green)
		updateInfo()

		-- A window left over from the previous cycle would look like "the joiner
		-- accepted" the moment the request goes out, so let it go first.
		if tradeGui() ~= nil then
			waitForTradeClosed(CONFIG.TRADE_CLOSE_SECONDS)
		end

		-- Every attempt starts with a clean slate: the verdict from the previous
		-- attempt ("nowindow", a stale accept, ...) is never reused as if it
		-- belonged to the request that is about to go out.
		sync.events["reqok"] = nil
		sync.events["items"] = nil
		sync.events["accept"] = nil
		sync.events["confirm"] = nil

		local requested, requestError = requestTrade(targetPlayer, targetUsername, cycle)
		if not requested then
			if tostring(requestError) == "stopped" then
				return "stop"
			end
			setStatus(
				string.format("Cycle %d: the trade request could not be sent (%s).", cycle, tostring(requestError)),
				THEME.red
			)
			return "retry"
		end

		-- The timings below count from the request that actually went through,
		-- not from a refused attempt before it.
		local cycleStartedAt = nowSeconds()

		-- Two independent proofs that the joiner accepted: it says so the moment
		-- its window opens, and the server opens this client's window at the same
		-- instant. Either is enough, so a window that lags behind or a quiet relay
		-- can never stall the cycle.
		local acceptedAt = nil
		local deadline = nowSeconds() + CONFIG.REQUEST_ACK_SECONDS
		while state.running and nowSeconds() < deadline do
			if tradeGui() ~= nil then
				acceptedAt = nowSeconds()
				print(string.format("[Trade] %s accepted - the trade window is open", targetUsername))
				break
			end
			local reply = sync.events["reqok"]
			if reply ~= nil and reply.cycle >= cycle and tostring(reply.payload) == "open" then
				acceptedAt = nowSeconds()
				print("[Trade] " .. targetUsername .. " says it accepted the request")
				break
			end
			waitSeconds(0.2)
		end

		if acceptedAt == nil then
			-- The relay may know why it never opened; ask it, then send the same
			-- request again instead of adding items into nothing.
			local joinerReady, readyPayload = waitForSync("reqok", cycle, 2)
			if joinerReady and tostring(readyPayload) == "nowindow" then
				print("[Trade] " .. targetUsername .. " says its trade window never opened - sending the request again")
			else
				print("[Trade] the trade window never opened after the request - sending the request again")
			end
			setStatus(string.format(
				"Cycle %d: the trade window did not open - asking %s again...",
				cycle,
				targetUsername
			), THEME.amber)
			return "retry"
		end
		print(string.format(
			"[Trade] request -> accepted in %.1fs; adding the items in %ss",
			acceptedAt - cycleStartedAt,
			tostring(CONFIG.REQUEST_SETTLE_SECONDS)
		))
		if not state.running then
			return "stop"
		end

		-- The joiner accepted, so the window is live on both clients. The items go
		-- in REQUEST_SETTLE_SECONDS after that, not after the request itself.
		waitSeconds(CONFIG.REQUEST_SETTLE_SECONDS)

		setStatus(string.format("Cycle %d: adding %d item(s)...", cycle, #batch), THEME.green)

		-- The trade window is left alone here: it stays visible and enabled the
		-- whole time, on both clients.
		for _, itemName in ipairs(batch) do
			offerItem(itemName)
			print("[Trade] offered " .. tostring(itemName))
			waitSeconds(CONFIG.ITEM_OFFER_GAP_SECONDS)
		end
		-- Tell the joiner the items are all in, so it counts its 6 seconds from
		-- the same moment this side does.
		publishSync("items", targetUsername, cycle, tostring(#batch))
		print(string.format(
			"[Trade] all %d item(s) added; both sides accept in %ss",
			#batch,
			tostring(CONFIG.ACCEPT_DELAY_SECONDS)
		))
		print("[Trade] told " .. targetUsername .. ": items are in - accept in " .. tostring(CONFIG.ACCEPT_DELAY_SECONDS) .. "s")

		local acceptAt = nowSeconds() + CONFIG.ACCEPT_DELAY_SECONDS
		while state.running do
			local left = acceptAt - nowSeconds()
			if left <= 0 then
				break
			end
			setStatus(string.format("Cycle %d: accepting in %ss...", cycle, tostring(math.ceil(left))), THEME.green)
			waitSeconds(math.min(1, left))
		end
		if not state.running then
			return "stop"
		end

		local accepted, acceptErr = pressAccept()
		if not accepted then
			-- This side never reached the accepted state, so there is nothing to
			-- confirm. Handing the cycle back is what stops a half-agreed trade.
			print("[Trade] this side did not accept the items (" .. tostring(acceptErr) .. ") - not confirming")
			publishSync("accept", targetUsername, cycle, "notaccepted")
			return "retry"
		end
		publishSync("accept", targetUsername, cycle, "ok")
		print("[Trade] this side accepted the items - waiting for " .. targetUsername .. " to say the same")

		local joinerAccepted, joinerPayload = waitForSync("accept", cycle, CONFIG.ACK_WAIT_SECONDS)
		if joinerAccepted and tostring(joinerPayload) ~= "ok" then
			-- The joiner could not accept. Confirming here would close a trade
			-- nobody agreed to, so hand the cycle back instead.
			print("[Trade] " .. targetUsername .. " reported its accept as '" .. tostring(joinerPayload) .. "' - asking again instead of confirming")
			return "retry"
		end
		if not joinerAccepted then
			-- One more window before giving up on the message: the relay can lag.
			print("[Trade] no word from " .. targetUsername .. " yet - waiting for it before confirming")
			joinerAccepted, joinerPayload = waitForSync("accept", cycle, CONFIG.ACK_WAIT_SECONDS)
		end
		if joinerAccepted and tostring(joinerPayload) ~= "ok" then
			print("[Trade] " .. targetUsername .. " reported its accept as '" .. tostring(joinerPayload) .. "' - asking again instead of confirming")
			return "retry"
		end
		if joinerAccepted then
			setStatus(string.format("Cycle %d: %s accepted too - confirming.", cycle, targetUsername), THEME.green)
			print("[Trade] " .. targetUsername .. " says it accepted too - both sides are in, confirming")
		else
			-- Both sides have to confirm for a trade to run, so confirming here can
			-- never move items on its own - it only stops an open window hanging.
			print("[Trade] WARNING: " .. targetUsername .. " never said it accepted. Both sides were told to accept; confirming so the trade does not hang on an open window.")
			setStatus(string.format(
				"Cycle %d: no word from %s - confirming so the trade does not hang.",
				cycle,
				targetUsername
			), THEME.amber)
		end

		waitSeconds(CONFIG.CONFIRM_DELAY_SECONDS)

		local confirmed, confirmErr = pressConfirm()
		if not confirmed then
			print("[Trade] could not press confirm: " .. tostring(confirmErr))
		end
		-- No "confirm" message is sent: the window closing is the signal that this
		-- cycle is over, and every message saved here is one the relay can spend
		-- on the next cycle's request.

		-- The next request cannot go out while this window is still up.
		waitForTradeClosed(CONFIG.TRADE_CLOSE_SECONDS)
		waitSeconds(CONFIG.TRADE_SETTLE_SECONDS)

		local after = getFreshWeaponQueue()
		local left = #batch
		if after ~= nil then
			left = countStillInQueue(batch, after)
		end
		local moved = #batch - left

		if moved <= 0 then
			emptyCycles = emptyCycles + 1
			print(string.format(
				"[Trade] cycle %d traded nothing: all %d item(s) are still in the salvage",
				cycle,
				#batch
			))
			return "retry"
		end

		emptyCycles = 0
		traded = traded + moved
		print(string.format(
			"=== Trade cycle %d complete: %d item(s) traded, %d in total ===",
			cycle,
			moved,
			traded
		))
		return "ok"
	end

	while state.running do
		local queue, info = getFreshWeaponQueue()
		if queue == nil then
			error("the inventory could not be read")
		end

		if #queue == 0 then
			-- One empty read is not proof: the salvage list is rebuilt by the game
			-- and used to come back empty while items were still there.
			print("[Trade] nothing tradable in that read - double checking before stopping")
			local again, againInfo, confirmed = waitForFinished()
			if not state.running then
				break
			end
			if againInfo ~= nil then
				-- What the last read saw, including anything it could not offer.
				info = againInfo
			end
			if again ~= nil and #again > 0 then
				queue, info = again, againInfo
				print("[Trade] good thing I checked: " .. tostring(#again) .. " item(s) are still tradable")
			elseif confirmed then
				print(string.format(
					"[Trade] nothing tradable left - read the salvage and every tab again %d times and only the kept item(s) remain (%s).",
					CONFIG.DONE_CONFIRM_ATTEMPTS,
					keptNamesText()
				))
				break
			else
				print("[Trade] STOPPED WITHOUT CONFIRMING: the tabs and the salvage kept disagreeing.")
				if info ~= nil and info.unlistedNames ~= nil then
					local names = {}
					for name in pairs(info.unlistedNames) do
						names[#names + 1] = tostring(name)
						if #names >= 8 then
							break
						end
					end
					if #names > 0 then
						print("[Trade] still in the inventory but not in the salvage list: " .. table.concat(names, ", "))
					end
				end
				print("[Trade] " .. tostring(lastKeptCount) .. " kept item(s): " .. keptNamesText())
				break
			end
		end

		local remaining = #queue
		cycle = cycle + 1

		local batch = {}
		for i = 1, math.min(CONFIG.MAX_ITEMS_PER_TRADE, remaining) do
			batch[#batch + 1] = queue[i]
		end

		print(string.format(
			"=== Trade cycle %d: %d item(s) this trade, %d tradable left (%d kept back) ===",
			cycle,
			#batch,
			remaining,
			lastKeptCount
		))

		local outcome = runCycle(batch)

		if outcome == "stop" then
			break
		elseif outcome == "retry" then
			cycle = cycle - 1
			if emptyCycles >= CONFIG.MAX_EMPTY_CYCLES then
				error(string.format(
					"the last %d trades moved nothing - the items are not reaching the trade window",
					emptyCycles
				))
			end
			-- A trade that just closed needs a moment before the next request.
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		else
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		end
	end

	publishSync("done", targetUsername, cycle, tostring(traded))
	print(string.format("[Trade] finished after %d cycle(s), %d item(s) traded.", cycle, traded))
	return true
end


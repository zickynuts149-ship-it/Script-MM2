		Font = Enum.Font.GothamMedium,
		TextSize = 11,
		TextColor3 = THEME.soft,
		Text = "Copy Job ID",
		Parent = card,
	})
	corner(copyButton, 6)
	stroke(copyButton, THEME.line)

	-- Drag from the header.
	local dragging = false
	local dragStart, startPosition
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPosition = card.Position
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not dragging then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			card.Position = UDim2.new(
				startPosition.X.Scale,
				startPosition.X.Offset + delta.X,
				startPosition.Y.Scale,
				startPosition.Y.Offset + delta.Y
			)
		end
	end)

	return {
		gui = gui,
		card = card,
		dot = dot,
		info = infoLabel,
		status = statusLabel,
		stop = stopButton,
		trade = tradeButton,
		copy = copyButton,
	}
end

ui = buildUI()

--------------------------------------------------------------------------
-- Who is running this script
--------------------------------------------------------------------------


local gameName = cleanText(tostring(game.Name or ""), 60)
if gameName == "" then
	gameName = "Unknown game"
end

local hostDisplay = cleanText(tostring(localPlayer.DisplayName or localPlayer.Name or ""), 40)
if hostDisplay == "" then
	hostDisplay = "Unknown player"
end

local hostUsername = cleanText(tostring(localPlayer.Name or ""), 40)
if hostUsername == "" then
	hostUsername = "Unknown player"
end

local placeId = tonumber(game.PlaceId) or 0

--------------------------------------------------------------------------
-- State
--------------------------------------------------------------------------


state = {
	running = true,
	active = nil,     -- { username, display, firstSeen }
	tradeStarted = false,
	tradeRunning = false,
	tradeTarget = nil,
	finished = false,
}

setStatus = function(text, color)
	ui.status.Text = text
	ui.status.TextColor3 = color
	ui.dot.BackgroundColor3 = color
end

updateInfo = function()
	local lines = {
		"Host: " .. hostDisplay .. " (@" .. hostUsername .. ")",
		"Game: " .. gameName,
		"Place: " .. tostring(tonumber(game.PlaceId) or placeId),
		"Job: " .. (currentJobId() == "" and "not available yet" or currentJobId()),
	}

	if state.tradeTarget ~= nil then
		lines[#lines + 1] = "CONNECTED: " .. state.tradeTarget .. (state.finished and " (finished)" or " (trading now)")
	elseif state.active ~= nil then
		lines[#lines + 1] = "CONNECTED: " .. state.active.username
	else
		lines[#lines + 1] = "NOT CONNECTED: nobody else in this server yet"
	end

	lines[#lines + 1] = "Link: " .. linkState()
	ui.info.Text = table.concat(lines, "\n")
end

--------------------------------------------------------------------------
-- Who to trade with
--------------------------------------------------------------------------

--
-- Nothing joins anybody: both people are already in this server. The other side
-- of the trade is simply the other player in the Players list, so there is no
-- handshake to wait for - the username the trade request needs is read straight
-- from the game.

local function findPlayerByUsername(username)
	local wanted = tostring(username):lower()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Name:lower() == wanted then
			return player
		end
	end
	return nil
end

-- The other person in this server: with one host and one joiner that is the
-- side this one trades with.
local function theOtherPlayer()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer then
			return player
		end
	end
	return nil
end

-- CONFIG.TARGET pins a username; otherwise it is whoever else is here.
local function resolveTarget()
	if CONFIG.TARGET ~= nil and tostring(CONFIG.TARGET) ~= "" then
		return findPlayerByUsername(tostring(CONFIG.TARGET))
	end
	-- Whoever the link heard from first, as long as they are really here (the
	-- link only believes players standing in this server), then simply whoever
	-- else is here.
	if link.peerUsername ~= "" then
		local linked = findPlayerByUsername(link.peerUsername)
		if linked ~= nil then
			return linked
		end
	end
	return theOtherPlayer()
end

--------------------------------------------------------------------------
-- Running the coordinated trade loop with the joiner
--------------------------------------------------------------------------


local function runTrade(targetPlayer, targetUsername)
	if state.tradeStarted then
		setStatus("The trade loop is already running for " .. tostring(state.tradeTarget) .. ".", THEME.amber)
		return false
	end

	if targetPlayer == nil or targetPlayer.Parent == nil then
		setStatus("That player is not in this server any more.", THEME.red)
		return false
	end

	state.tradeStarted = true
	state.tradeTarget = targetUsername
	ui.trade.Text = "Trading..."
	print("[Server Share] starting the coordinated trade loop with " .. targetUsername)

	spawnThread(function()
		local ok, result = pcall(runTradeLoop, targetPlayer, targetUsername)
		if not ok then
			state.tradeStarted = false
			state.tradeRunning = false
			state.tradeTarget = nil
			ui.trade.Text = "Run trade"
			print("[Server Share] trade loop stopped: " .. tostring(result))
			setStatus("Trade loop stopped: " .. tostring(result), THEME.red)
			updateInfo()
			return
		end

		state.tradeRunning = false
		state.finished = true
		ui.trade.Text = "Finished"
		setStatus(
			"Done. Every tradable item is gone; only the Default Gun and Default Knife are left.",
			THEME.green
		)
		updateInfo()
	end)

	updateInfo()
	setStatus("Trading with " .. targetUsername .. " now.", THEME.green)
	return true
end

--------------------------------------------------------------------------
-- Buttons
--------------------------------------------------------------------------


ui.stop.MouseButton1Click:Connect(function()
	state.running = false
	ui.gui:Destroy()
	print("[Trade] stopped, channel " .. channelCode)
end)

ui.trade.MouseButton1Click:Connect(function()
	if state.tradeStarted then
		setStatus("The trade loop is already running for " .. tostring(state.tradeTarget) .. ".", THEME.amber)
		return
	end
	local target = resolveTarget()
	if target ~= nil then
		runTrade(target, target.Name)
		return
	end
	setStatus("Nobody else is in this server yet.", THEME.amber)
end)

ui.copy.MouseButton1Click:Connect(function()
	local copied = false
	local environment = type(getgenv) == "function" and getgenv() or _G
	for _, name in ipairs({ "setclipboard", "toclipboard" }) do
		local fn = rawget(environment, name)
		if type(fn) == "function" then
			local ok = pcall(fn, room)
			copied = copied or ok
		end
	end
	ui.copy.Text = copied and "Copied" or "Copy failed"
	waitSeconds(1.2)
	if ui.gui.Parent then
		ui.copy.Text = "Copy Room"
	end
end)

--------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------


if not httpAvailable then
	setStatus("This executor does not expose HTTP requests, so it cannot talk to the joiner.", THEME.red)
	print("[Trade] this executor does not expose HTTP requests")
	return
end

updateInfo()
setStatus("Starting...", THEME.amber)

-- The link runs from the first second, so CONNECTED can be said the moment
-- the other script says hello - and the trade starts right then.
startRelayLoop()

spawnThread(function()
	local announced = false
	local otherSince = nil
	while state.running and not state.tradeStarted do
		local linked = link.connected and findPlayerByUsername(link.peerUsername) ~= nil
		local target = resolveTarget()

		if target ~= nil then
			if otherSince == nil then
				otherSince = nowSeconds()
			end
			-- The link's hello is the proof that both scripts are running. Without
			-- it (relay busy, or the other side still loading) the trade starts
			-- anyway: no step of it needs the relay.
			if linked or nowSeconds() - otherSince >= CONFIG.LINK_FALLBACK_SECONDS then
				if linked then
					print("[Trade] CONNECTED to " .. target.Name .. " over the link - starting the trade now")
				else
					print("[Trade] CONNECTED to " .. target.Name .. " (same server, the relay has not answered) - starting the trade anyway")
				end
				setStatus("CONNECTED to " .. target.Name .. " - starting the trade", THEME.green)
				state.active = { username = target.Name }
				updateInfo()
				waitSeconds(CONFIG.TRADE_START_DELAY_SECONDS)
				if state.running and not state.tradeStarted then
					local again = resolveTarget()
					if again ~= nil then
						state.active = { username = again.Name }
						runTrade(again, again.Name)
					end
				end
				return
			end
		else
			otherSince = nil
			if not announced then
				announced = true
				print("[Trade] waiting for the other person to be in this server (both scripts must be in the SAME server)")
				setStatus("NOT CONNECTED - waiting for the other person. Both scripts must be in the SAME server.", THEME.amber)
			end
		end

		waitSeconds(0.25)
	end
end)

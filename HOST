local function waitSeconds(seconds)
	if task and task.wait then
		return task.wait(seconds)
	end
	return wait(seconds)
end

local function spawnThread(fn)
	if task and task.spawn then
		return task.spawn(fn)
	end
	return spawn(fn)
end

-- Wall clock in seconds, used for the countdown.
local function nowSeconds()
	if type(tick) == "function" then
		return tick()
	end
	return os.clock()
end

local function safeField(container, key)
	if container == nil then
		return nil
	end
	if type(container) ~= "table" and typeof(container) ~= "Instance" and type(container) ~= "userdata" then
		return nil
	end
	local ok, value = pcall(function()
		return container[key]
	end)
	if ok then
		return value
	end
	return nil
end

-- Removes control characters, separators and runs of spaces, so a name can
-- never break the wire format or the layout.
local function cleanText(text, maxLength)
	if type(text) ~= "string" then
		return ""
	end
	text = text:gsub("[%c]", " ")
	text = text:gsub("|", "/")
	text = text:gsub("%s+", " ")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if maxLength and #text > maxLength then
		text = text:sub(1, maxLength - 1) .. "..."
	end
	return text
end

local function toHex(text)
	return (tostring(text):gsub(".", function(char)
		return string.format("%02x", string.byte(char))
	end))
end

--------------------------------------------------------------------------
-- HTTP bridge (executors expose this under different names)
--------------------------------------------------------------------------

local function urlEncode(value)
	return (tostring(value):gsub("[^%w%-%._~]", function(char)
		return string.format("%%%02X", string.byte(char))
	end))
end

local httpRequest
for _, candidate in ipairs({
	safeField(syn, "request"),
	safeField(http, "request"),
	safeField(fluxus, "request"),
	safeField(krnl, "request"),
	rawget(_G, "http_request"),
	rawget(_G, "request"),
}) do
	if type(candidate) == "function" then
		httpRequest = candidate
		break
	end
end

-- Returns: ok (boolean, HTTP 2xx), status code, body
local function http(url, method, body, headers)
	if httpRequest then
		local sent, response = pcall(httpRequest, {
			Url = url,
			Method = method or "GET",
			Headers = headers or {},
			Body = body,
		})
		if not sent then
			return false, 0, tostring(response)
		end
		if type(response) == "string" then
			-- Older shims hand back the body directly.
			return true, 200, response
		end
		if type(response) ~= "table" then
			return false, 0, "unexpected executor response"
		end
		local status = tonumber(response.StatusCode or response.Status or response.status or response.statusCode or response.code) or 0
		local responseBody = response.Body or response.body or ""
		if type(responseBody) ~= "string" then
			responseBody = tostring(responseBody)
		end
		return status >= 200 and status < 300, status, responseBody
	end

	-- Fallback for executors that only shim game:HttpGet (GET requests only).
	if method == nil or method == "GET" then
		local ok, response = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and type(response) == "string" then
			return true, 200, response
		end
		return false, 0, tostring(response)
	end

	return false, 0, "this executor does not support HTTP requests"
end

local httpAvailable = httpRequest ~= nil
if not httpAvailable then
	local ok, getter = pcall(function()
		return game.HttpGet
	end)
	httpAvailable = ok and type(getter) == "function"
end

--------------------------------------------------------------------------
-- The link to the other side
--
-- This is the ServerChat transport, used exactly the way it is used there:
--
--   * Both clients work out the SAME channel name from this server's JobId
--     (with ROOM as the salt). Two people in different servers therefore never
--     see each other, and nothing left over from an older server is read.
--   * A message is one line, its fields separated by \1:
--       V1 | kind | clientId | username | displayName | cycle | event | payload | stamp
--   * It is published with  POST <relay>/<channel>  and read back with
--       GET <relay>/<channel>/json?poll=1&since=<last id seen>
--     The cursor starts at "3m" (recent history) and afterwards only moves
--     to ids that actually came back, so a read only ever returns what is new.
--   * A line is believed only when its sender is a player standing in this
--     server right now - the same check ServerChat makes - so somebody else
--     using the relay is ignored.
--
-- The link says who the other side is (the username the request is addressed
-- to), puts CONNECTED on both cards, and carries each step of the trade as a
-- hint. No step waits for a message: the trade window and the clock run the
-- cycle, so a slow, busy or dead relay costs a log line, not a trade.
--------------------------------------------------------------------------

local function sanitizeRoom(raw)
	local cleaned = tostring(raw or ""):lower():gsub("[^%w_%-]", "")
	if #cleaned > 48 then
		cleaned = cleaned:sub(1, 48)
	end
	if cleaned == "" then
		cleaned = "main"
	end
	return cleaned
end

local room = sanitizeRoom(CONFIG.ROOM)
local relayBase = tostring(CONFIG.RELAY_URL):gsub("/+$", "")

-- Filled in further down. The trade code runs before the UI is built, so it
-- needs these names up front and assigns to them there.
local ui, state, setStatus, updateInfo, THEME

local SEP = string.char(1)

-- A fresh id every run, like ServerChat's clientId.
math.randomseed(os.time() + math.floor((os.clock and os.clock() or 0) * 1000000))
local function randomId(length)
	local pool = "abcdefghijklmnopqrstuvwxyz0123456789"
	local out = {}
	for i = 1, length do
		local k = math.random(1, #pool)
		out[i] = pool:sub(k, k)
	end
	return table.concat(out)
end

local clientId = randomId(12)
local myName = tostring(localPlayer.Name or "")
local myDisplay = cleanText(tostring(localPlayer.DisplayName or myName), 40)

local function hash32(text)
	local h = 5381
	for i = 1, #text do
		h = (h * 33 + string.byte(text, i)) % 4294967296
	end
	return h
end

-- 32-bit hash printed as eight hex digits. Written out by hand so it works
-- the same in every Lua (no %x needed).
local function hex32(value)
	local digits = "0123456789abcdef"
	local out = {}
	local n = math.floor(value or 0) % 4294967296
	for i = 1, 8 do
		local d = n % 16
		out[9 - i] = digits:sub(d + 1, d + 1)
		n = math.floor((n - d) / 16)
	end
	return table.concat(out)
end

local function buildChannel()
	local jobId = ""
	pcall(function()
		jobId = tostring(game.JobId or "")
	end)
	if jobId == "" then
		-- JobId is normally readable on the client; without it, the place alone
		-- still gives a working channel.
		jobId = "noplace" .. tostring(game.PlaceId)
	end
	local seed = tostring(room) .. "|" .. tostring(game.PlaceId) .. "|" .. jobId
	return "rbxshare" .. hex32(hash32(seed)) .. hex32(hash32(seed .. "#2"))
end

local channel = buildChannel()
local channelCode = channel:sub(-6):upper()
local publishUrl = relayBase .. "/" .. channel
local pollUrlBase = publishUrl .. "/json?poll=1&since="

local function currentJobId()
	local ok, job = pcall(function()
		return game.JobId
	end)
	if ok and type(job) == "string" then
		return job
	end
	return ""
end

local function relayPublish(text)
	if httpRequest then
		local ok, status = http(publishUrl, "POST", text, { ["Content-Type"] = "text/plain" })
		return ok, status
	end
	-- GET publish, for the game:HttpGet-only fallback.
	return http(relayBase .. "/" .. channel .. "/publish?message=" .. urlEncode(text), "GET")
end

-- Split on \1 and keep empty fields: a payload may be empty.
local function splitFields(raw)
	local fields = {}
	local start = 1
	while true do
		local found, last = string.find(raw, SEP, start, true)
		if not found then
			fields[#fields + 1] = string.sub(raw, start)
			return fields
		end
		fields[#fields + 1] = string.sub(raw, start, found - 1)
		start = last + 1
	end
end

local function encodeMessage(kind, cycle, event, payload)
	return table.concat({
		"V1",
		cleanText(tostring(kind or ""), 8),
		clientId,
		cleanText(myName, 40),
		myDisplay,
		tostring(tonumber(cycle) or 0),
		cleanText(tostring(event or ""), 16),
		cleanText(tostring(payload or ""), 60),
		tostring(os.time()),
	}, SEP)
end

local function decodeMessage(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = splitFields(text)
	if #parts ~= 9 or parts[1] ~= "V1" then
		return nil
	end
	local cycle = tonumber(parts[6])
	local stamp = tonumber(parts[9])
	if cycle == nil or stamp == nil then
		return nil
	end
	return {
		kind = cleanText(parts[2], 8),
		from = parts[3],
		username = cleanText(parts[4], 40),
		display = cleanText(parts[5], 40),
		cycle = cycle,
		event = cleanText(parts[7], 16),
		payload = cleanText(parts[8], 60),
		stamp = stamp,
	}
end

-- The smallest JSON reader that is enough for ntfy's one-object-per-line
-- replies (this is the same one ServerChat uses).
local function jsonString(line, key)
	local needle = '"' .. key .. '":"'
	local start = line:find(needle, 1, true)
	if not start then
		return nil
	end
	local i = start + #needle
	local out = {}
	while i <= #line do
		local char = line:sub(i, i)
		if char == "\\" then
			local nextChar = line:sub(i + 1, i + 1)
			if nextChar == "u" then
				local code = tonumber(line:sub(i + 2, i + 5), 16)
				if code and code <= 0x10FFFF and not (code >= 0xD800 and code <= 0xDFFF) then
					out[#out + 1] = utf8.char(code)
				else
					out[#out + 1] = "?"
				end
				i = i + 6
			elseif nextChar == "n" then
				out[#out + 1] = "\n"
				i = i + 2
			elseif nextChar == "t" then
				out[#out + 1] = "\t"
				i = i + 2
			elseif nextChar == "r" then
				out[#out + 1] = "\r"
				i = i + 2
			else
				out[#out + 1] = nextChar
				i = i + 2
			end
		elseif char == '"' then
			return table.concat(out)
		else
			out[#out + 1] = char
			i = i + 1
		end
	end
	return table.concat(out)
end

local link = {
	started = false,
	startedAt = 0,
	polling = false,
	connected = false,
	connectedAt = 0,
	peerUsername = "",
	peerDisplay = "",
	peerAckedAt = 0,
	events = {},
	cursor = "3m",
	answered = false,
	trouble = 0,
	lastError = nil,
	lastNoteAt = 0,
	lastHelloAt = -1e9,  -- so the first hello goes out at once
	lastHelloFailed = false,
}

local function linkState()
	if link.connected then
		return "linked with " .. (link.peerDisplay ~= "" and link.peerDisplay or link.peerUsername)
	elseif link.answered then
		return "relay answering, waiting for the other script"
	elseif link.trouble > 0 then
		return "relay busy - trading on the clock"
	end
	return "relay starting"
end

-- ntfy.sh allows 60 requests as a burst, then about one per 10 seconds, for a
-- whole network. Both clients share that, so polls are spaced out and the Polls are spaced out, and the optional per-step messages only go
-- out when this bucket has a token, so several busy cycles cannot drain the
-- allowance. The two that matter - the request and "finished" - always go out.
local bucket = { tokens = 4, burst = 4, perToken = 12, at = nowSeconds() }

local function takeToken()
	local at = nowSeconds()
	while bucket.tokens < bucket.burst and at - bucket.at >= bucket.perToken do
		bucket.tokens = bucket.tokens + 1
		bucket.at = bucket.at + bucket.perToken
	end
	if bucket.tokens <= 0 then
		return false
	end
	bucket.tokens = bucket.tokens - 1
	return true
end

local function publishMessage(kind, cycle, event, payload)
	local forced = kind == "hello" or kind == "ack" or event == "req" or event == "done"
	if not forced and not takeToken() then
		return false
	end
	local ok, status = relayPublish(encodeMessage(kind, cycle, event, payload))
	if not ok and nowSeconds() - link.lastNoteAt > 60 then
		link.lastNoteAt = nowSeconds()
		print("[Trade] the relay did not take a message (" .. tostring(status) .. ") - the trade keeps its own clock")
	end
	return ok
end

-- The call sites below name who a message is for. The channel is already this
-- server only, so the name is not needed on the wire - it stays in the log.
local function publishSync(event, toUsername, cycle, payload)
	return publishMessage("trade", cycle, event, payload)
end

local function notePeer(entry)
	local first = not link.connected
	link.peerUsername = entry.username
	link.peerDisplay = entry.display ~= "" and entry.display or entry.username
	if first then
		link.connected = true
		link.connectedAt = nowSeconds()
		print(string.format(
			"[Trade] CONNECTED to %s (@%s) over the link - both scripts are in this server",
			link.peerDisplay,
			link.peerUsername
		))
		if setStatus ~= nil and THEME ~= nil then
			setStatus("CONNECTED to " .. link.peerDisplay .. " - starting the trade", THEME.green)
		end
	end
	return first
end

-- One read: only the messages that arrived after the last id we saw.
local function pollLink()
	if link.polling then
		return false
	end
	link.polling = true
	local ok, status, body = http(pollUrlBase .. link.cursor, "GET")
	link.polling = false

	if not ok then
		link.trouble = link.trouble + 1
		link.lastError = status
		if nowSeconds() - link.lastNoteAt > 60 then
			link.lastNoteAt = nowSeconds()
			if status == 429 then
				print("[Trade] the relay asked us to slow down - the trade keeps its own clock, nothing is blocked")
			else
				print("[Trade] relay read failed (" .. tostring(status) .. ") - the trade keeps its own clock")
			end
		end
		return false
	end

	link.trouble = 0
	link.lastError = nil
	link.answered = true

	for line in tostring(body):gmatch("[^\r\n]+") do
		if jsonString(line, "event") == "message" then
			local id = jsonString(line, "id")
			if id ~= nil then
				link.cursor = id
			end
			local payload = jsonString(line, "message")
			if payload ~= nil then
				local entry = decodeMessage(payload)
				if entry ~= nil and entry.from ~= clientId and entry.username:lower() ~= myName:lower() then
					-- ServerChat's rule: only somebody really standing in this server.
					local here = nil
					pcall(function()
						here = Players:FindFirstChild(entry.username)
					end)
					if here ~= nil then
						if entry.event == "hello" then
							notePeer(entry)
							local at = nowSeconds()
							if at - link.peerAckedAt >= 20 then
								link.peerAckedAt = at
								publishMessage("ack", 0, "ack", "")
							end
						elseif entry.event == "ack" then
							notePeer(entry)
						elseif entry.event ~= "" then
							local current = link.events[entry.event]
							if current == nil or entry.cycle > current.cycle
								or (entry.cycle == current.cycle and entry.stamp >= current.stamp) then
								link.events[entry.event] = entry
							end
						end
					end
				end
			end
		end
	end
	return true
end

-- One loop does both jobs: say hello now and then, and read the channel. The
-- pause grows while the relay is refusing, so a busy relay is waited out
-- quietly instead of being hammered.
local function startRelayLoop()
	if link.started then
		return
	end
	link.started = true
	link.startedAt = nowSeconds()
	spawnThread(function()
		while state ~= nil and state.running do
			local at = nowSeconds()
			local gap = CONFIG.LINK_HELLO_SECONDS
			if link.connected then
				gap = CONFIG.LINK_KEEPALIVE_SECONDS
			elseif link.lastHelloFailed then
				-- A hello that was refused is retried quickly: it is the one
				-- message the handshake needs.
				gap = CONFIG.LINK_HELLO_RETRY_SECONDS
			end
			if at - link.lastHelloAt >= gap then
				link.lastHelloAt = at
				link.lastHelloFailed = not publishMessage("hello", 0, "hello", "host")
			end
			pollLink()
			-- For the first seconds the channel is read every 1.5s, so two copies
			-- started together say CONNECTED almost at once. After that the normal
			-- pace applies: the relay allows 60 requests as a burst and then only
			-- about one every 10 seconds.
			local pause = CONFIG.LINK_POLL_SECONDS
			if nowSeconds() - link.startedAt < CONFIG.LINK_START_POLL_WINDOW then
				pause = CONFIG.LINK_START_POLL_SECONDS
			end
			if link.trouble > 0 then
				pause = math.min(CONFIG.LINK_MAX_POLL_SECONDS, pause * (1 + link.trouble))
			end
			waitSeconds(pause)
		end
	end)
end


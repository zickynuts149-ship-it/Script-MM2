-- Declared before the press code that calls it; filled in just below.
local ensureTradeWindowShown

--------------------------------------------------------------------------
-- Pressing the trade buttons
--
-- Reading Container.Trade.Actions.Accept.Confirm.ActionButton before the server
-- has processed the accept does not give nil, it throws "Confirm is not a valid
-- member of Frame" and the script dies right there. The game builds the confirm
-- page only after the accept has been processed, which is exactly why the
-- confirm step used to work only sometimes. So: nothing below hard-indexes a
-- child that may not exist yet, a signal is only fired when the game really has
-- something connected to it, and every step is retried until the game shows it
-- took. Same code as the joiner's.
--------------------------------------------------------------------------

local ACTIONS_PATH = { "Container", "Trade", "Actions" }
local ACCEPT_PATH = { "Container", "Trade", "Actions", "Accept", "ActionButton" }
local CONFIRM_PATH = { "Container", "Trade", "Actions", "Accept", "Confirm", "ActionButton" }

local PATH_WAIT = 5               -- how long a missing child may take to appear
local ACCEPT_VERIFY_WAIT = 2      -- how long the game may take to show the accept took
local CONFIRM_PAGE_WAIT = 10      -- how long the confirm page may take after the accept
local CONFIRM_NUDGE_SECONDS = 2.5 -- press accept again this often while it is missing
local CONFIRM_PRESS_TRIES = 6
local CONFIRM_PRESS_WAIT = 0.4

local PRESS_SIGNALS = { "MouseButton1Click", "Activated" }
local PRESS_CHECK_DELAY = CONFIG.ACCEPT_PRESS_CHECK_SECONDS
local HAS_GETCONNECTIONS = type(getconnections) == "function"
local pressCounts = setmetatable({}, { __mode = "k" })

local ACCEPT_PRESS_ATTEMPTS = CONFIG.ACCEPT_PRESS_ATTEMPTS
local ACCEPT_PRESS_RETRY = CONFIG.ACCEPT_PRESS_RETRY_SECONDS

local function describeButton(button)
	if button == nil then
		return "not found"
	end
	local text = "?"
	local colour = "?"
	local visible = "?"
	local active = "?"
	pcall(function() text = tostring(button.Text) end)
	pcall(function()
		local c = button.BackgroundColor3
		colour = string.format(
			"%d,%d,%d",
			math.floor(c.R * 255 + 0.5),
			math.floor(c.G * 255 + 0.5),
			math.floor(c.B * 255 + 0.5)
		)
	end)
	pcall(function() visible = tostring(button.Visible) end)
	pcall(function() active = tostring(button.Active) end)
	return string.format("text=%s colour=%s visible=%s active=%s", text, colour, visible, active)
end

-- A real mouse click, for executors that expose mouse movement. It is only
-- used when no button signal could be fired at all.
local function realClick(button)
	local ok, positionX, positionY = pcall(function()
		local absolute = button.AbsolutePosition
		local size = button.AbsoluteSize
		return absolute.X + size.X / 2, absolute.Y + size.Y / 2
	end)
	if not ok then
		return false
	end
	local containers = { _G }
	if type(getgenv) == "function" then
		local envOk, env = pcall(getgenv)
		if envOk and type(env) == "table" then
			containers[#containers + 1] = env
		end
	end
	local move = nil
	local click = nil
	for _, container in ipairs(containers) do
		move = move or safeField(container, "mousemoveabs")
		click = click or safeField(container, "mouse1click")
	end
	if type(move) ~= "function" or type(click) ~= "function" then
		return false
	end
	pcall(move, positionX, positionY)
	waitSeconds(0.05)
	pcall(click)
	return true
end

-- Walk a child path without ever hard-indexing a child that is not there yet.
local function tradePath(root, names, timeout)
	timeout = timeout or 0
	local started = nowSeconds()
	local node = root
	for _, name in ipairs(names) do
		if node == nil then
			return nil
		end
		local child = nil
		pcall(function()
			child = node:FindFirstChild(name)
		end)
		if child == nil and timeout > 0 then
			local left = timeout - (nowSeconds() - started)
			if left > 0 then
				pcall(function()
					child = node:WaitForChild(name, left)
				end)
			end
		end
		if child == nil then
			return nil
		end
		node = child
	end
	return node
end

-- True only when the element and every ancestor is actually on screen.
local function isShown(instance)
	if instance == nil then
		return false
	end
	local node = instance
	while node ~= nil do
		local shown = true
		pcall(function()
			if node:IsA("GuiObject") then
				shown = node.Visible
			elseif node:IsA("LayerCollector") then
				shown = node.Enabled
			end
		end)
		if not shown then
			return false
		end
		local parent = nil
		pcall(function()
			parent = node.Parent
		end)
		node = parent
	end
	return true
end

local function fireSignal(signal)
	if type(firesignal) == "function" then
		return pcall(firesignal, signal)
	end
	return pcall(function()
		signal:Fire()
	end)
end

-- firesignal silently does nothing when the game has not connected the
-- button's handler yet: no error, no click. So wait for a connection first.
local function fireWhenConnected(signal, timeout)
	timeout = timeout or 1.5
	local started = nowSeconds()
	repeat
		if not HAS_GETCONNECTIONS then
			-- This executor cannot look, so firing is all that can be done.
			return fireSignal(signal)
		end
		local ok, connections = pcall(getconnections, signal)
		if ok and type(connections) == "table" and #connections > 0 then
			return fireSignal(signal)
		end
		waitSeconds(0.05)
	until nowSeconds() - started > timeout
	return false
end

-- One signal, then a look at whether the game reacted, and only then the other
-- signal. Firing both in the same pass would press a toggling button and
-- immediately unpress it, so the second one is only used when the first did
-- nothing at all. The signals also rotate between presses, so a press that the
-- game ignored is retried through a different one.
local PRESS_REACT_WAIT = 0.15

local function pressButton(button, timeout)
	if button == nil then
		return false, "no button"
	end

	local used = pressCounts[button] or 0
	pressCounts[button] = used + 1
	local before = describeButton(button)
	local fired = nil

	for offset = 0, #PRESS_SIGNALS - 1 do
		local name = PRESS_SIGNALS[((used + offset) % #PRESS_SIGNALS) + 1]
		local signal = nil
		pcall(function()
			signal = button[name]
		end)
		if signal ~= nil and fireWhenConnected(signal, timeout) then
			fired = fired or name
			waitSeconds(PRESS_REACT_WAIT)
			if tradeGui() == nil then
				return true, name
			end
			if describeButton(button) ~= before then
				return true, name
			end
		end
	end

	if fired ~= nil then
		return true, fired
	end
	if realClick(button) then
		return true, "mouse"
	end
	return false, "no signal"
end

-- The confirm button, once the game has built its page. It is looked up, never
-- indexed, and some trade UIs replace the accept page with the confirm page
-- instead of nesting it, so the other visible ActionButton is a fallback.
local function findConfirm(gui)
	local exact = tradePath(gui, CONFIRM_PATH, 0)
	if exact ~= nil and isShown(exact) then
		return exact
	end
	local actions = tradePath(gui, ACTIONS_PATH, 0)
	if actions ~= nil then
		local ok, descendants = pcall(function()
			return actions:GetDescendants()
		end)
		if ok and descendants ~= nil then
			local accept = tradePath(gui, ACCEPT_PATH, 0)
			for _, child in ipairs(descendants) do
				local name = nil
				pcall(function()
					name = child.Name
				end)
				if name == "ActionButton" and child ~= accept and isShown(child) then
					return child
				end
			end
		end
	end
	return exact
end

local function confirmPageUp(gui)
	local confirm = findConfirm(gui)
	return confirm ~= nil and isShown(confirm)
end

-- Everything pressable that is in the window, for when a step refuses to work.
local function dumpTradeButtons(gui)
	if gui == nil then
		return
	end
	print("[Trade] buttons in the trade window right now:")
	local ok, descendants = pcall(function()
		return gui:GetDescendants()
	end)
	if not ok or descendants == nil then
		return
	end
	for _, child in ipairs(descendants) do
		local name = nil
		local text = nil
		pcall(function()
			name = child:GetFullName()
		end)
		pcall(function()
			text = tostring(child.Text)
		end)
		if name ~= nil and text ~= nil then
			print(string.format("[Trade]   %s  shown=%s  text=%q", name, tostring(isShown(child)), text))
		end
	end
end

-- The game itself sometimes switches this player's trade window off (Enabled
-- goes false) when the request is accepted. A switched-off window cannot be
-- accepted or confirmed - the button signals go nowhere, which is exactly the
-- "the host accepted but nothing happened" symptom. Nothing here ever switches
-- it off: this only ever turns it back on. Same code as the joiner's.
local windowRestores = 0

ensureTradeWindowShown = function()
	local gui = tradeGui()
	if gui == nil then
		return false
	end
	local ok, enabled = pcall(function()
		return gui.Enabled
	end)
	if ok and enabled ~= true then
		local fixed = pcall(function()
			gui.Enabled = true
		end)
		if fixed then
			windowRestores = windowRestores + 1
			print("[Trade] the trade window had been switched off (Enabled = false) - switched it back on")
		end
	end
	return true
end

-- Keeps the trade window switched on for the whole session, in a loop. It runs
-- the entire time, not only while a trade is open, because whatever switches
-- the window off can do it at any moment. Every pass sets Enabled = true;
-- nothing here ever sets it to false, hides anything or deletes anything.
local SHOW_LOOP_SECONDS = 0.1

local function startTradeWindowKeepAlive()
	spawnThread(function()
		while state ~= nil and state.running do
			local gui = tradeGui()
			if gui ~= nil then
				local wasOff = false
				pcall(function()
					wasOff = gui.Enabled ~= true
					gui.Enabled = true
				end)
				if wasOff then
					windowRestores = windowRestores + 1
					print("[Trade] the trade window was off - switched it back on (" .. tostring(windowRestores) .. ")")
				end
			end
			waitSeconds(SHOW_LOOP_SECONDS)
		end
	end)
end

startTradeWindowKeepAlive()

-- Presses accept and keeps pressing until the game shows it took it. The
-- confirm page appearing, the accept button changing, or the window closing are
-- the proof; a signal call on its own proves nothing. Same code as the joiner's.
local function pressAccept()
	local lastReason = "the trade window is not open"
	for attempt = 1, ACCEPT_PRESS_ATTEMPTS do
		ensureTradeWindowShown()
		local gui = tradeGui()
		if gui == nil then
			return false, lastReason
		end

		local button = tradePath(gui, ACCEPT_PATH, PATH_WAIT)
		if button == nil then
			lastReason = "the accept button could not be found"
			print("[Trade] accept attempt " .. tostring(attempt) .. ": the accept button is not in the window yet")
		else
			local before = describeButton(button)
			local pressed, how = pressButton(button, PRESS_CHECK_DELAY)
			if pressed then
				local name = "?"
				pcall(function()
					name = button:GetFullName()
				end)
				print(string.format(
					"[Trade] accept attempt %d: fired %s on %s (was %s)",
					attempt,
					tostring(how),
					name,
					before
				))

				local deadline = nowSeconds() + ACCEPT_VERIFY_WAIT
				while (state == nil or state.running) and nowSeconds() < deadline do
					local live = tradeGui()
					if live == nil then
						print("[Trade] the trade window closed after the accept press")
						return true, "window closed"
					end
					if confirmPageUp(live) then
						print("[Trade] the game took the accept - the confirm page is up")
						return true, "confirm page"
					end
					waitSeconds(0.05)
				end

				-- Second look at the accept button itself: some trade UIs show
				-- "accepted" without building the confirm page right away.
				local live = tradeGui()
				if live ~= nil then
					local current = tradePath(live, ACCEPT_PATH, 0)
					if current ~= nil and describeButton(current) ~= before then
						print("[Trade] the accept button changed - the game took the accept")
						return true, "button changed"
					end
				end

				lastReason = "the game never showed the accept"
				print(string.format("[Trade] accept attempt %d did not register - pressing again", attempt))
			else
				lastReason = "no button signal could be fired (" .. tostring(how) .. ")"
				print("[Trade] accept attempt " .. tostring(attempt) .. ": " .. lastReason)
			end
		end

		if attempt < ACCEPT_PRESS_ATTEMPTS then
			waitSeconds(ACCEPT_PRESS_RETRY)
		end
	end
	return false, lastReason
end

-- Waits for the confirm page instead of guessing a delay, then presses confirm
-- and keeps pressing until the page, or the whole window, is gone.
local function pressConfirm()
	for attempt = 1, CONFIRM_PRESS_TRIES do
		ensureTradeWindowShown()
		local gui = tradeGui()
		if gui == nil then
			print("[Trade] the trade window is closed - nothing left to confirm")
			return true, "window closed"
		end

		local deadline = nowSeconds() + (attempt == 1 and CONFIRM_PAGE_WAIT or 1)
		local nudgedAt = nowSeconds()
		local confirm = findConfirm(gui)
		while confirm == nil or not isShown(confirm) do
			local live = tradeGui()
			if live == nil then
				print("[Trade] the trade closed while waiting for the confirm page")
				return true, "window closed"
			end
			gui = live
			if nowSeconds() >= deadline then
				break
			end
			if nowSeconds() - nudgedAt >= CONFIRM_NUDGE_SECONDS then
				nudgedAt = nowSeconds()
				local accept = tradePath(gui, ACCEPT_PATH, 0)
				if accept ~= nil then
					print("[Trade] the confirm page has not appeared - pressing accept again")
					pressButton(accept, 1)
				end
			end
			waitSeconds(0.05)
			confirm = findConfirm(gui)
		end

		if confirm == nil then
			print("[Trade] the confirm button is not in the trade window")
			dumpTradeButtons(gui)
			return false, "no confirm button"
		end

		local pressed, how = pressButton(confirm, 1.5)
		if pressed then
			print(string.format("[Trade] fired %s on the confirm button", tostring(how)))
		else
			print("[Trade] the confirm button could not be pressed (" .. tostring(how) .. ")")
		end

		local settle = nowSeconds() + CONFIRM_PRESS_WAIT
		while nowSeconds() < settle do
			waitSeconds(0.05)
		end
		local live = tradeGui()
		if live == nil then
			print("[Trade] done - the trade closed")
			return true, "closed"
		end
		local still = findConfirm(live)
		if still == nil or not isShown(still) then
			print("[Trade] done - the confirm page is gone")
			return true, "confirmed"
		end
		print(string.format("[Trade] confirm attempt %d: the trade is still open - pressing again", attempt))
	end

	dumpTradeButtons(tradeGui())
	print("[Trade] confirm was pressed " .. tostring(CONFIRM_PRESS_TRIES) .. " times and the trade is still open")
	return false, "still open"
end

local function tradeRemote(name)
	local ok, remote = pcall(function()
		local container = ReplicatedStorage:WaitForChild("Trade", 10)
		if container == nil then
			return nil
		end
		return container:WaitForChild(name, 10)
	end)
	if ok then
		return remote
	end
	return nil
end

local function sendTradeRequest(targetPlayer)
	local remote = tradeRemote("SendRequest")
	if remote == nil then
		return false, "Trade.SendRequest could not be found"
	end
	local ok, err = pcall(function()
		remote:InvokeServer(targetPlayer)
	end)
	if not ok then
		return false, tostring(err)
	end
	return true
end

local function offerItem(itemName)
	local remote = tradeRemote("OfferItem")
	if remote == nil then
		return false
	end
	return pcall(function()
		remote:FireServer(itemName, "Weapons")
	end)
end

--------------------------------------------------------------------------
-- Reading the salvage / inventory
--
-- Same tiers and same stack expansion as your trade script, but every weapons
-- tab is discovered rather than listed, item cards are found by their label
-- (the game does not name them the same way in every tab), and the only items
-- left alone are the Default Gun and Default Knife while they sit in Currents.
--------------------------------------------------------------------------

local tradePaths = nil
-- How many items were skipped as "keep" by the last read (Default Gun / Knife).
local lastKeptCount = 0
-- The names that were left alone by the last read.
local lastKeptNames = {}
-- Names already explained in the console, so the note is printed once.
local sharedNoted = {}

-- Lowercase, letters and digits only: "Default_Knife_ab12" and "Default Knife"
-- then compare the way a player would read them.
local function normalizeName(text)
	local lowered = tostring(text or ""):lower()
	return (lowered:gsub("[^%w]", ""))
end

local KEEP_KEYS = {}
for _, name in ipairs(CONFIG.KEEP_ITEM_NAMES) do
	KEEP_KEYS[#KEEP_KEYS + 1] = normalizeName(name)
end

-- True when a name is one of the two defaults. `lenient` also accepts a suffix
-- ("Default_Knife_ab12" from the salvage list); the strict form is used for
-- inventory cards, so a skin called "Default Gun Gold" is still traded.
local function isKeepKey(key, lenient)
	if key == nil or key == "" then
		return false
	end
	for _, keep in ipairs(KEEP_KEYS) do
		if key == keep then
			return true
		end
		if lenient and #key > #keep and key:sub(1, #keep) == keep then
			return true
		end
		if not lenient and #key > #keep and key:sub(1, #keep) == keep then
			local rest = key:sub(#keep + 1)
			if rest:match("^%d+$") then
				return true
			end
		end
	end
	return false
end

-- The tab an item sits in decides whether the keep rule applies at all: a
-- Default Gun in Events or Classic is still traded away.
local function tabMatchesKeepTab(tab)
	if tab == nil then
		-- Unknown tab: leave the default behind rather than trade it by accident.
		return true
	end
	local name = tostring(tab)
	if name == CONFIG.KEEP_TAB then
		return true
	end
	return name:sub(1, #CONFIG.KEEP_TAB + 1) == CONFIG.KEEP_TAB .. "/"
end

local function isKeptItem(data)
	if data == nil then
		return false
	end
	if not isKeepKey(data.key, false) then
		return false
	end
	return tabMatchesKeepTab(data.tab)
end

-- A child that may not exist, without ever hanging on it.
local function childOf(parent, name, timeout)
	if parent == nil then
		return nil
	end
	local ok, found = pcall(function()
		return parent:FindFirstChild(name) or parent:WaitForChild(name, timeout or 2)
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

-- The same, but without waiting: used while walking a list that is expected to
-- be there already, where waiting on every label would add up to minutes.
local function findChild(parent, name)
	if parent == nil then
		return nil
	end
	local ok, found = pcall(function()
		return parent:FindFirstChild(name)
	end)
	if ok and typeof(found) == "Instance" then
		return found
	end
	return nil
end

local function tradeRoots()
	local ok, roots = pcall(function()
		local gui = childOf(localPlayer, "PlayerGui", 10)
		local main = childOf(gui, "MainGUI", 20)
		local gameGui = childOf(main, "Game", 20)
		return gameGui
	end)
	if ok and typeof(roots) == "Instance" then
		return roots
	end
	return nil
end

-- Every weapons tab under Items.Container, whatever it is called. Current and
-- Classic are found this way, and so is the Events group (Holiday ->
-- Halloween, Christmas, ...): a tab the script has never heard of is still read
-- and its items still traded.
local function collectTabs(parent, prefix, list, depth)
	if parent == nil or depth > 3 then
		return
	end
	local ok, children = pcall(function()
		return parent:GetChildren()
	end)
	if not ok or children == nil then
		return
	end
	for _, node in ipairs(children) do
		if node ~= nil and typeof(node) == "Instance" then
			-- Item cards also have a Container child (the stack amount), so they
			-- are told apart by the ItemName label that only cards carry.
			if findChild(node, "ItemName") == nil then
				local tabName = prefix ~= "" and (prefix .. "/" .. tostring(node.Name)) or tostring(node.Name)
				local container = findChild(node, "Container")
				if container ~= nil then
					list[#list + 1] = { tab = tabName, node = container }
				end
				collectTabs(node, tabName, list, depth + 1)
			end
		end
	end
end

local function salvageContainer(gameGui)
	local crafting = childOf(gameGui, "Crafting", 15)
	local inventory = childOf(crafting, "Inventory", 10) or crafting
	local salvage = childOf(inventory, "Salvage", 10)
	if salvage == nil then
		local ok, found = pcall(function()
			return gameGui:FindFirstChild("Salvage", true)
		end)
		if ok and typeof(found) == "Instance" then
			salvage = found
		end
	end
	if salvage == nil then
		return nil
	end
	local scroll = childOf(salvage, "ScrollFrame", 3)
	local container = childOf(scroll or salvage, "Container", 3)
	return container or scroll or salvage
end

-- The three nodes every read needs: the Game gui, the tab holder and the
-- salvage list. Cached, and re-found when a node the game rebuilt goes away.
local function resolveTradePaths()
	if tradePaths ~= nil then
		local alive = false
		pcall(function()
			alive = tradePaths.game.Parent ~= nil
				and tradePaths.tabHolder.Parent ~= nil
				and tradePaths.salvage.Parent ~= nil
		end)
		if alive then
			return tradePaths
		end
		tradePaths = nil
	end

	local gameGui = tradeRoots()
	if gameGui == nil then
		return nil
	end
	local inventoryGui = childOf(gameGui, "Inventory", 15)
	local main = inventoryGui and childOf(inventoryGui, "Main", 10)
	local weapons = main and childOf(main, "Weapons", 10)
	local itemsNode = weapons and childOf(weapons, "Items", 10)
	local tabHolder = itemsNode and childOf(itemsNode, "Container", 10)
	if tabHolder == nil then
		return nil
	end
	local salvage = salvageContainer(gameGui)
	if salvage == nil then
		return nil
	end

	tradePaths = { game = gameGui, tabHolder = tabHolder, salvage = salvage }
	return tradePaths
end

-- The longest inventory name that fits a salvage frame name. The old version
-- compared first words, which made every "Default_*" frame match "Default Gun";
-- the longest fit cannot do that, so similarly named items keep their own tab.
local function matchItem(frameName, index, cards)
	local key = normalizeName(frameName)
	if key == "" then
		return nil
	end
	local exact = index[key]
	if exact ~= nil then
		return exact
	end
	local best, bestLen = nil, 0
	for _, data in ipairs(cards) do
		local candidate = data.key
		if #candidate >= 4 then
			if key:sub(1, #candidate) == candidate then
				if #candidate > bestLen then
					best, bestLen = data, #candidate
				end
			elseif #key >= 4 and candidate:sub(1, #key) == key and #key > bestLen then
				best, bestLen = data, #key
			end
		end
	end
	return best
end

local function shuffleTable(list)
	for i = #list, 2, -1 do
		local j = math.random(i)
		list[i], list[j] = list[j], list[i]
	end
end

pcall(function()
	math.randomseed(tick())
end)

local function getFreshWeaponQueue()
	local paths = resolveTradePaths()
	if paths == nil then
		return nil, nil
	end

	local tabs = {}
	collectTabs(paths.tabHolder, "", tabs, 0)

	local cards = {}
	local index = {}
	local shared = {}

	for _, tab in ipairs(tabs) do
		local ok, children = pcall(function()
			return tab.node:GetChildren()
		end)
		if ok and children ~= nil then
			for _, card in ipairs(children) do
				-- Cards are found by their label, not by name: the game does not
				-- use the same name for every card in every tab.
				local itemName = findChild(card, "ItemName")
				local label = itemName and findChild(itemName, "Label")
				if label ~= nil and label:IsA("TextLabel") then
					local text = tostring(label.Text)
					local key = normalizeName(text)
					if key ~= "" then
						local amount = 1
						local cardContainer = findChild(card, "Container")
						local amountObject = cardContainer and findChild(cardContainer, "Amount")
						if amountObject ~= nil then
							local digits = tostring(amountObject.Text or ""):match("%d+")
							amount = tonumber(digits) or 1
						end
						local data = {
							label = text,
							key = key,
							tab = tab.tab,
							amount = math.max(1, amount),
						}
						pcall(function()
							data.color = itemName.BackgroundColor3
						end)
						cards[#cards + 1] = data
						local existing = index[key]
						if existing == nil then
							index[key] = data
						else
							shared[key] = true
							-- The Currents entry wins, because that is the tab the
							-- Default Gun and Default Knife live in.
							if existing.tab ~= CONFIG.KEEP_TAB and tab.tab == CONFIG.KEEP_TAB then
								index[key] = data
							end
						end
					end
				end
			end
		end
	end

	-- Said once, not on every read: the same note twenty times helps nobody.
	for key in pairs(shared) do
		if isKeepKey(key, false) and not sharedNoted[key] then
			sharedNoted[key] = true
			local label = index[key] and index[key].label or key
			print("[Trade] note: '" .. tostring(label) .. "' also exists in another tab; treating it as the Currents one")
		end
	end

	local okSalvage, salvageChildren = pcall(function()
		return paths.salvage:GetChildren()
	end)
	if not okSalvage or salvageChildren == nil then
		return nil, nil
	end

	local tier1, tier2, tier3 = {}, {}, {} -- 1: RGB(100,10,255)  2: RGB(255,0,179)  3: the rest
	local kept, keptNames = 0, {}
	local matched = {}

	for _, frame in ipairs(salvageChildren) do
		local frameName = tostring(frame.Name)
		local data = matchItem(frameName, index, cards)
		if data ~= nil then
			matched[data.key] = true
		end

		-- Kept: the Default Gun and Default Knife, in Currents. A frame the tabs
		-- do not explain falls back to its own name, so a default that is not in
		-- any tab is still never offered.
		if isKeptItem(data) or (data == nil and isKeepKey(normalizeName(frameName), true)) then
			kept = kept + (data and data.amount or 1)
			keptNames[data and data.label or frameName] = true
		else
			local entry = { frameName = frameName, amount = data and data.amount or 1 }
			local tier = tier3
			if data ~= nil and data.color ~= nil then
				local r = math.floor(data.color.R * 255 + 0.5)
				local g = math.floor(data.color.G * 255 + 0.5)
				local b = math.floor(data.color.B * 255 + 0.5)
				if r == 100 and g == 10 and b == 255 then
					tier = tier1
				elseif r == 255 and g == 0 and b == 179 then
					tier = tier2
				end
			end
			tier[#tier + 1] = entry
		end
	end

	shuffleTable(tier1)
	shuffleTable(tier2)
	shuffleTable(tier3)

	local queue = {}
	for _, tier in ipairs({ tier1, tier2, tier3 }) do
		for _, item in ipairs(tier) do
			for _ = 1, item.amount do
				queue[#queue + 1] = item.frameName
			end
		end
	end

	-- Cards the salvage list did not show. Reported rather than traded: the
	-- trade takes the salvaged name, and offering a name the trade does not know
	-- would only waste a slot.
	local unlisted, unlistedNames = 0, {}
	for _, data in ipairs(cards) do
		if not matched[data.key] and not isKeptItem(data) and unlistedNames[data.label] == nil then
			unlistedNames[data.label] = true
			unlisted = unlisted + 1
		end
	end

	lastKeptCount = kept
	lastKeptNames = keptNames
	return queue, {
		salvage = #salvageChildren,
		tradable = #queue,
		kept = kept,
		unlisted = unlisted,
		unlistedNames = unlistedNames,
		tabs = #tabs,
	}
end

local function keptNamesText(limit)
	local names = {}
	for name in pairs(lastKeptNames) do
		names[#names + 1] = tostring(name)
		if #names >= (limit or 6) then
			break
		end
	end
	if #names == 0 then
		return "none found"
	end
	return table.concat(names, ", ")
end

-- An empty salvage read is not proof that the run is over: the game rebuilds
-- that list, and a read can land while it is still filling in, which used to
-- end a run with items still in the inventory. This keeps reading until the
-- answer holds still:
--   * a tradable item shows up            -> not over, hand it back
--   * the tabs are readable and nothing
--     in them or in the salvage is
--     tradable, read the same way a few
--     times in a row                      -> confirmed finished
--   * the list keeps coming back with
--     nothing in it, or the tabs still
--     show items the salvage never lists  -> not confirmed; reported, never
--                                            claimed as "all traded".
local function waitForFinished()
	local lastInfo = nil
	local confirms = 0
	local empties = 0
	while state.running do
		local queue, info = getFreshWeaponQueue()
		if queue == nil then
			empties = empties + 1
			if empties > CONFIG.EMPTY_READ_ATTEMPTS then
				return nil, lastInfo, false
			end
			print("[Trade] the inventory could not be read - reading again")
			waitSeconds(CONFIG.EMPTY_READ_GAP_SECONDS)
		elseif #queue > 0 then
			return queue, info, false
		else
			lastInfo = info
			if info ~= nil and info.tabs > 0 and info.unlisted == 0 then
				confirms = confirms + 1
				if confirms >= CONFIG.DONE_CONFIRM_ATTEMPTS then
					return nil, info, true
				end
				waitSeconds(CONFIG.DONE_CONFIRM_GAP_SECONDS)
			else
				empties = empties + 1
				if empties > CONFIG.EMPTY_READ_ATTEMPTS then
					return nil, info, false
				end
				waitSeconds(CONFIG.EMPTY_READ_GAP_SECONDS)
			end
		end
	end
	return nil, lastInfo, false
end

--------------------------------------------------------------------------
-- The coordinated trade loop
--
--   request out (+ tell the joiner) -> 1s -> joiner accepts (+ tells the host)
--   -> 2s -> add up to 4 items -> 6s -> this side presses accept and tells the
--   joiner to press too, 1s later -> both accept -> 1s -> confirm -> 0.5s ->
--   next request. No dead time between cycles, until nothing tradable is left
--   (the Default Gun and Default Knife in Currents are never offered).
--------------------------------------------------------------------------

-- Asks for a trade and keeps trying while the game refuses. A request is
-- refused while another trade is still open and for a moment after one, which
-- used to end the whole loop on the second cycle.
local function requestTrade(targetPlayer, targetUsername, cycle)
	local lastError = nil
	for attempt = 1, CONFIG.REQUEST_ATTEMPTS do
		if not state.running then
			return false, "stopped"
		end
		if targetPlayer == nil or targetPlayer.Parent == nil then
			return false, targetUsername .. " left the server"
		end

		local ok, err = sendTradeRequest(targetPlayer)
		if ok then
			-- Tell the joiner the request is on its way, so it can accept it one
			-- second from now instead of guessing when to press.
			publishSync("req", targetUsername, cycle, tostring(attempt))
			print(string.format("[Trade] request sent to %s (attempt %d)", targetUsername, attempt))
			print("[Trade] told " .. targetUsername .. ": the request is out - accept it now")
			return true
		end

		lastError = err
		print(string.format("[Trade] request attempt %d failed: %s", attempt, tostring(err)))
		setStatus(string.format(
			"Cycle %d: the request was refused (%s). Retrying in %ds...",
			cycle,
			tostring(err),
			CONFIG.REQUEST_RETRY_SECONDS
		), THEME.amber)
		waitSeconds(CONFIG.REQUEST_RETRY_SECONDS)
	end
	return false, lastError
end

-- The game refuses a new request while a trade window is still up, so the next
-- request waits for this client's window to go away first. The cap keeps a game
-- that leaves the window instance in place from stalling the loop.
local function waitForTradeClosed(seconds)
	local deadline = nowSeconds() + seconds
	while state ~= nil and state.running and nowSeconds() < deadline do
		if tradeGui() == nil then
			return true
		end
		waitSeconds(0.25)
	end
	return tradeGui() == nil
end

local function countStillInQueue(batch, queue)
	local present = {}
	for _, name in ipairs(queue or {}) do
		local key = tostring(name):lower()
		present[key] = (present[key] or 0) + 1
	end
	local left = 0
	for _, name in ipairs(batch) do
		local key = tostring(name):lower()
		if (present[key] or 0) > 0 then
			present[key] = present[key] - 1
			left = left + 1
		end
	end
	return left
end

local function runTradeLoop(targetPlayer, targetUsername)
	if resolveTradePaths() == nil then
		error("the inventory and salvage containers could not be found")
	end

	local cycle = 0
	local traded = 0
	local emptyCycles = 0

	startRelayLoop()

	-- One full round trip. "ok" means the items left the inventory, "retry"
	-- means this trade did not happen at all, "stop" means the script is done.
	local function runCycle(batch)
		setStatus(string.format("Cycle %d: sending %s a trade request...", cycle, targetUsername), THEME.green)
		updateInfo()

		-- A window left over from the previous cycle would look like "the joiner
		-- accepted" the moment the request goes out, so let it go first.
		if tradeGui() ~= nil then
			waitForTradeClosed(CONFIG.TRADE_CLOSE_SECONDS)
		end

		local requested, requestError = requestTrade(targetPlayer, targetUsername, cycle)
		if not requested then
			if tostring(requestError) == "stopped" then
				return "stop"
			end
			setStatus(
				string.format("Cycle %d: the trade request could not be sent (%s).", cycle, tostring(requestError)),
				THEME.red
			)
			return "retry"
		end

		-- The timings below count from the request that actually went through,
		-- not from a refused attempt before it.
		local cycleStartedAt = nowSeconds()

		-- The window opening HERE is the joiner having accepted: the server only
		-- opens the trade for a request that was accepted. Both clients can see
		-- that for themselves, so adding the items starts on this fact and not on
		-- a message that might not arrive.
		local acceptedAt = nil
		local deadline = nowSeconds() + CONFIG.REQUEST_ACK_SECONDS
		while state.running and nowSeconds() < deadline do
			if tradeGui() ~= nil then
				acceptedAt = nowSeconds()
				print(string.format("[Trade] %s accepted - the trade window is open", targetUsername))
				break
			end
			waitSeconds(0.2)
		end

		if acceptedAt == nil then
			print("[Trade] the trade window never opened after the request - sending the request again")
			setStatus(
				string.format("Cycle %d: the trade window did not open - asking %s again...", cycle, targetUsername),
				THEME.amber
			)
			return "retry"
		end
		print(string.format(
			"[Trade] request -> accepted in %.1fs; adding the items in %ss",
			acceptedAt - cycleStartedAt,
			tostring(CONFIG.REQUEST_SETTLE_SECONDS)
		))
		if not state.running then
			return "stop"
		end

		-- The joiner accepted, so the window is live on both clients. The items go
		-- in REQUEST_SETTLE_SECONDS after that, not after the request itself.
		waitSeconds(CONFIG.REQUEST_SETTLE_SECONDS)

		setStatus(string.format("Cycle %d: adding %d item(s)...", cycle, #batch), THEME.green)

		-- The trade window is left alone here: it stays visible and enabled the
		-- whole time, on both clients.
		for _, itemName in ipairs(batch) do
			offerItem(itemName)
			print("[Trade] offered " .. tostring(itemName))
			waitSeconds(CONFIG.ITEM_OFFER_GAP_SECONDS)
		end

		local lastItemAt = nowSeconds()
		-- Told, never waited on: it is the joiner's backup clock for the case
		-- where its own window does not show the items.
		publishSync("items", targetUsername, cycle, tostring(#batch))
		print(string.format(
			"[Trade] all %d item(s) added - this side accepts in %ss, then %s accepts %ss later",
			#batch,
			tostring(CONFIG.ACCEPT_DELAY_SECONDS),
			targetUsername,
			tostring(CONFIG.JOINER_ACCEPT_DELAY_SECONDS)
		))

		local acceptAt = lastItemAt + CONFIG.ACCEPT_DELAY_SECONDS
		while state.running do
			local left = acceptAt - nowSeconds()
			if left <= 0 then
				break
			end
			setStatus(string.format("Cycle %d: accepting in %ss...", cycle, tostring(math.ceil(left))), THEME.green)
			waitSeconds(math.min(1, left))
		end
		if not state.running then
			return "stop"
		end

		-- Told as it happens, so the console on both sides shows the same order.
		publishSync("acceptgo", targetUsername, cycle, "now")
		print("[Trade] told " .. targetUsername .. ": accepting now - press accept in " .. tostring(CONFIG.JOINER_ACCEPT_DELAY_SECONDS) .. "s")

		local accepted, acceptErr = pressAccept()
		if not accepted then
			-- This side never reached the accepted state, so there is nothing to
			-- confirm. Handing the cycle back is what stops a half-agreed trade.
			print("[Trade] this side did not accept the items (" .. tostring(acceptErr) .. ") - not confirming")
			publishSync("hostaccept", targetUsername, cycle, "notaccepted")
			return "retry"
		end
		publishSync("hostaccept", targetUsername, cycle, "ok")
		print("[Trade] this side accepted the items")

		-- The joiner was told the same moment and presses accept one second after
		-- this side, then confirms a second after that. Confirming on the clock
		-- keeps the two sides together without a round trip; a trade only runs
		-- when BOTH sides confirm, so an early confirm here cannot move anything
		-- on its own.
		waitSeconds(CONFIG.CONFIRM_DELAY_SECONDS)
		local confirmed, confirmErr = pressConfirm()
		if not confirmed then
			print("[Trade] could not press confirm: " .. tostring(confirmErr))
		end

		-- If the window is still up a few seconds later, the joiner's own confirm
		-- had not landed yet: press once more rather than leaving it hanging.
		local recheck = nowSeconds() + 4
		while state.running and nowSeconds() < recheck and tradeGui() ~= nil do
			waitSeconds(0.25)
		end
		if tradeGui() ~= nil then
			print("[Trade] the trade window is still open - pressing confirm once more")
			pressConfirm()
		end

		-- The next request cannot go out while this window is still up.
		waitForTradeClosed(CONFIG.TRADE_CLOSE_SECONDS)
		waitSeconds(CONFIG.TRADE_SETTLE_SECONDS)

		local after = getFreshWeaponQueue()
		local left = #batch
		if after ~= nil then
			left = countStillInQueue(batch, after)
		end
		local moved = #batch - left

		if moved <= 0 then
			emptyCycles = emptyCycles + 1
			print(string.format(
				"[Trade] cycle %d traded nothing: all %d item(s) are still in the salvage",
				cycle,
				#batch
			))
			return "retry"
		end

		emptyCycles = 0
		traded = traded + moved
		print(string.format(
			"=== Trade cycle %d complete: %d item(s) traded, %d in total ===",
			cycle,
			moved,
			traded
		))
		return "ok"
	end


	while state.running do
		local queue, info = getFreshWeaponQueue()
		if queue == nil then
			error("the inventory could not be read")
		end

		if #queue == 0 then
			-- One empty read is not proof: the salvage list is rebuilt by the game
			-- and used to come back empty while items were still there.
			print("[Trade] nothing tradable in that read - double checking before stopping")
			local again, againInfo, confirmed = waitForFinished()
			if not state.running then
				break
			end
			if againInfo ~= nil then
				-- What the last read saw, including anything it could not offer.
				info = againInfo
			end
			if again ~= nil and #again > 0 then
				queue, info = again, againInfo
				print("[Trade] good thing I checked: " .. tostring(#again) .. " item(s) are still tradable")
			elseif confirmed then
				print(string.format(
					"[Trade] nothing tradable left - read the salvage and every tab again %d times and only the kept item(s) remain (%s).",
					CONFIG.DONE_CONFIRM_ATTEMPTS,
					keptNamesText()
				))
				break
			else
				print("[Trade] STOPPED WITHOUT CONFIRMING: the tabs and the salvage kept disagreeing.")
				if info ~= nil and info.unlistedNames ~= nil then
					local names = {}
					for name in pairs(info.unlistedNames) do
						names[#names + 1] = tostring(name)
						if #names >= 8 then
							break
						end
					end
					if #names > 0 then
						print("[Trade] still in the inventory but not in the salvage list: " .. table.concat(names, ", "))
					end
				end
				print("[Trade] " .. tostring(lastKeptCount) .. " kept item(s): " .. keptNamesText())
				break
			end
		end

		local remaining = #queue
		cycle = cycle + 1

		local batch = {}
		for i = 1, math.min(CONFIG.MAX_ITEMS_PER_TRADE, remaining) do
			batch[#batch + 1] = queue[i]
		end

		print(string.format(
			"=== Trade cycle %d: %d item(s) this trade, %d tradable left (%d kept back) ===",
			cycle,
			#batch,
			remaining,
			lastKeptCount
		))

		local outcome = runCycle(batch)

		if outcome == "stop" then
			break
		elseif outcome == "retry" then
			cycle = cycle - 1
			if emptyCycles >= CONFIG.MAX_EMPTY_CYCLES then
				error(string.format(
					"the last %d trades moved nothing - the items are not reaching the trade window",
					emptyCycles
				))
			end
			-- A trade that just closed needs a moment before the next request.
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		else
			waitSeconds(CONFIG.NEXT_CYCLE_DELAY_SECONDS)
		end
	end

	-- Said a few times, because the relay is allowed to refuse and the joiner's
	-- card is nicer when it knows. Nothing depends on it: a joiner that never
	-- hears it simply waits for a request that is not coming.
	for _ = 1, 3 do
		publishSync("done", targetUsername, cycle, tostring(traded))
		if not state.running then
			break
		end
		waitSeconds(6)
	end
	print(string.format("[Trade] finished after %d cycle(s), %d item(s) traded.", cycle, traded))
	return true
end


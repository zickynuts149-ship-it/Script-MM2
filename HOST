--------------------------------------------------------------------------
-- Running the coordinated trade loop with the joiner
--------------------------------------------------------------------------

local function runTrade(targetPlayer, targetUsername)
	if state.tradeStarted then
		setStatus("The trade loop is already running for " .. tostring(state.tradeTarget) .. ".", THEME.amber)
		return false
	end

	if targetPlayer == nil or targetPlayer.Parent == nil then
		setStatus("That player is not in this server any more.", THEME.red)
		return false
	end

	state.tradeStarted = true
	state.tradeTarget = targetUsername
	ui.trade.Text = "Trading..."
	print("[Server Share] starting the coordinated trade loop with " .. targetUsername)

	spawnThread(function()
		local ok, result = pcall(runTradeLoop, targetPlayer, targetUsername)
		if not ok then
			state.tradeStarted = false
			state.tradeRunning = false
			state.tradeTarget = nil
			ui.trade.Text = "Run trade"
			print("[Server Share] trade loop stopped: " .. tostring(result))
			setStatus("Trade loop stopped: " .. tostring(result), THEME.red)
			updateInfo()
			return
		end

		state.tradeRunning = false
		state.finished = true
		ui.trade.Text = "Finished"
		setStatus(
			"Done. Traded down to the last " .. tostring(CONFIG.STOP_AT_REMAINING) .. " item(s); this server is no longer advertised.",
			THEME.green
		)
		updateInfo()
	end)

	updateInfo()
	setStatus("Trading with " .. targetUsername .. " now.", THEME.green)
	return true
end

--------------------------------------------------------------------------
-- Finding the joiner in this server
--------------------------------------------------------------------------

-- Only the exact Roblox username is trusted, because that same string ends up
-- as the trade target. Display names are only shown, never matched.
local function findPlayerByUsername(username)
	local wanted = tostring(username):lower()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= localPlayer and player.Name:lower() == wanted then
			return player
		end
	end
	return nil
end

-- Answers "is anybody hosting right now?", so a joiner only ever follows a
-- host that is actually alive. It stays quiet once somebody is already on the
-- way, while a trade runs, and after the last trade is done.
local lastPingReplyAt = 0
local lastPingKey = nil

local function hostingAvailable()
	if not state.running or state.finished then
		return false
	end
	if state.tradeStarted or state.tradeRunning or state.active ~= nil then
		return false
	end
	return #state.queue == 0
end

local function answerPing(ping, myPlace, myJob)
	if not hostingAvailable() then
		return
	end
	-- The same ping stays visible on the topic for minutes, so answer each one
	-- once. ntfy.sh only allows a limited number of messages per day.
	local key = ping.username:lower() .. "|" .. tostring(ping.stamp)
	if key == lastPingKey then
		return
	end
	if os.time() - lastPingReplyAt < CONFIG.PING_ACK_SECONDS then
		return
	end
	lastPingKey = key
	lastPingReplyAt = os.time()
	local ok, status = relayPublishTo(
		presenceTopic,
		encodeAck(myPlace, myJob, hostUsername, hostDisplay, gameName, os.time())
	)
	if ok then
		print("[Server Share] " .. ping.username .. " asked for a host - told them this server is live")
	else
		print("[Server Share] could not answer " .. ping.username .. " (error " .. tostring(status) .. ")")
	end
end

local function collectJoiners()
	local myJob = currentJobId()
	if myJob == "" then
		return
	end

	local url = relayBase .. "/" .. presenceTopic .. "/raw?poll=1&since=" .. tostring(CONFIG.PRESENCE_MAX_AGE_MINUTES) .. "m"
	local ok, status, body = http(url, "GET")
	if not ok then
		if status == 429 then
			print("[Server Share] joiner topic is rate limiting this network")
		else
			print("[Server Share] could not read the joiner topic (error " .. tostring(status) .. ")")
		end
		return
	end

	local myPlace = tonumber(game.PlaceId) or 0
	local found = {}
	local newestPing = nil

	for line in tostring(body):gmatch("[^\r\n]+") do
		local query = decodeQuery(line)
		if query then
			if query.username:lower() ~= hostUsername:lower()
				and os.time() - query.stamp <= CONFIG.PING_MAX_AGE_SECONDS
				then
				if newestPing == nil or query.stamp > newestPing.stamp then
					newestPing = query
				end
			end
		end

		local entry = decodePresence(line)
		if entry and entry.place == myPlace and entry.job == myJob
			and os.time() - entry.stamp <= CONFIG.JOINER_ANNOUNCE_MAX_AGE_SECONDS then
			-- One key per message, not per person: the same announcement is
			-- handled once, while a fresh announcement from the same person (a
			-- new timestamp) is still picked up.
			local name = entry.username:lower()
			local key = name .. "|" .. tostring(entry.stamp)
			local alreadyQueued = false
			if not state.seen[key] and name ~= hostUsername:lower() then
				for _, queued in ipairs(state.queue) do
					if queued.username:lower() == name then
						alreadyQueued = true
						break
					end
				end
				if not alreadyQueued then
					entry.key = key
					found[#found + 1] = entry
				end
			end
		end
	end

	table.sort(found, function(a, b)
		return a.stamp < b.stamp
	end)

	for _, entry in ipairs(found) do
		state.seen[entry.key or entry.username:lower()] = true
		state.queue[#state.queue + 1] = entry
		print("[Server Share] joiner announced: " .. entry.username .. " (" .. entry.display .. ")")
	end

	if #found > 0 then
		updateInfo()
	end

	if newestPing ~= nil then
		answerPing(newestPing, myPlace, myJob)
	end
end

local function startCountdown(active)
	spawnThread(function()
		local total = CONFIG.TRADE_START_DELAY_SECONDS
		while state.running and state.active == active and not active.started do
			local remaining = total - (nowSeconds() - active.detectedAt)
			if remaining <= 0 then
				break
			end
			if active.player == nil or active.player.Parent == nil then
				return
			end
			setStatus(string.format(
				"%s is in the server. Sending the first trade request in %d...",
				active.player.Name,
				math.ceil(remaining)
			), THEME.green)
			waitSeconds(math.min(1, math.max(0.1, remaining)))
		end

		if not state.running or state.active ~= active or active.started then
			return
		end
		if active.player == nil or active.player.Parent == nil then
			setStatus(active.username .. " left before the trade could start.", THEME.red)
			state.active = nil
			updateInfo()
			return
		end

		active.started = true
		if CONFIG.TRADE_ON_DETECT then
			runTrade(active.player, active.player.Name)
		else
			setStatus(active.player.Name .. " is in the server. Press Run trade to start.", THEME.green)
		end
	end)
end

--------------------------------------------------------------------------
-- Share loop (server info)
--------------------------------------------------------------------------

local function publish()
	if state.finished then
		-- Everything has been traded, so this server should not attract a new
		-- joiner any more. The card stays, the advertising stops.
		return true
	end

	local job = currentJobId()
	local place = tonumber(game.PlaceId) or placeId

	if job == "" then
		updateInfo()
		setStatus("This client did not expose a Job ID. Rejoin the server and run the script again.", THEME.red)
		return false
	end

	if state.lastJob ~= nil and job ~= state.lastJob then
		-- The server changed, so anything announced for the old one no longer counts.
		state.queue = {}
		state.seen = {}
		state.active = nil
		updateInfo()
	end

	local payload = encodeInfo(place, job, hostUsername, hostDisplay, gameName, os.time())
	local ok, status = relayPublish(payload)
	state.lastAttemptAt = os.time()
	state.lastOk = ok

	if ok then
		state.sentCount = state.sentCount + 1
		state.lastSentAt = os.time()
		state.lastJob = job
		updateInfo()
		if not state.active and not state.tradeStarted then
			setStatus("Live - shared at " .. os.date("%H:%M:%S") .. " (room " .. room .. ")", THEME.green)
		else
			ui.dot.BackgroundColor3 = THEME.green
		end
		return true
	end

	if status == 429 then
		setStatus("Relay is rate limiting this network. Will retry shortly.", THEME.amber)
	else
		setStatus("Could not reach the relay (error " .. tostring(status) .. "). Retrying...", THEME.red)
	end
	return false
end


	if state.active and state.active.player then
		state.active.started = true
		runTrade(state.active.player, state.active.player.Name)
		return
	end
	if state.active then
		setStatus(state.active.username .. " has announced this server but is not in it yet.", THEME.amber)
		return
	end
	if #state.queue > 0 then
		setStatus(state.queue[1].username .. " has announced this server but is not in it yet.", THEME.amber)
		return
	end
	setStatus("No joiner has announced this server yet.", THEME.amber)
end)

ui.copy.MouseButton1Click:Connect(function()
	local job = currentJobId()
	if job == "" then
		return
	end
	local copied = false
	local environment = type(getgenv) == "function" and getgenv() or _G
	for _, name in ipairs({ "setclipboard", "toclipboard" }) do
		local fn = rawget(environment, name)
		if type(fn) == "function" then
			local ok = pcall(fn, job)
			copied = copied or ok
		end
	end
	ui.copy.Text = copied and "Copied" or "Copy failed"
	waitSeconds(1.2)
	if ui.gui.Parent then
		ui.copy.Text = "Copy Job ID"
	end
end)

--------------------------------------------------------------------------
-- Start
--------------------------------------------------------------------------

if not httpAvailable then
	setStatus("This executor does not expose HTTP requests, so nothing can be shared or received.", THEME.red)
	print("[Server Share] this executor does not expose HTTP requests")
	return
end

updateInfo()
setStatus("Starting...", THEME.amber)

spawnThread(function()
	publish()
	while state.running do
		waitSeconds(CONFIG.CHECK_SECONDS)
		if not state.running then
			break
		end
		local job = currentJobId()
		local now = os.time()
		if job ~= "" and job ~= state.lastJob then
			publish()
		elseif not state.lastOk and now - state.lastAttemptAt >= CONFIG.RETRY_SECONDS then
			publish()
		elseif now - state.lastSentAt >= CONFIG.HEARTBEAT_SECONDS then
			publish()
		end
	end
end)

spawnThread(function()
	local lastPoll = 0
	while state.running do
		local now = os.time()

		if now - lastPoll >= CONFIG.PRESENCE_POLL_SECONDS then
			lastPoll = now
			collectJoiners()
		end

		-- Promote the oldest announcement to "the joiner we are waiting for".
		if not state.active and not state.tradeStarted and #state.queue > 0 then
			local entry = table.remove(state.queue, 1)
			state.active = {
				username = entry.username,
				display = entry.display,
				key = entry.key,
				stamp = entry.stamp,
				queuedAt = now,
				player = nil,
				detectedAt = nil,
				started = false,
			}
			updateInfo()
			setStatus(
				"Joiner " .. entry.username .. " announced this server. Waiting for them to appear...",
				THEME.amber
			)
		end

		if state.active then
			if state.active.player == nil then
				local player = findPlayerByUsername(state.active.username)
				if player then
					state.active.player = player
					state.active.detectedAt = nowSeconds()
					updateInfo()
					print("[Server Share] " .. player.Name .. " is in this server - first trade request in " .. tostring(CONFIG.TRADE_START_DELAY_SECONDS) .. "s")
					startCountdown(state.active)
				elseif now - (state.active.queuedAt or now) > CONFIG.JOINER_ARRIVAL_TIMEOUT_SECONDS then
					-- They announced themselves but never arrived, so stop holding
					-- this server for them: holding on is what kept the host from
					-- answering other joiners.
					print("[Server Share] " .. state.active.username .. " never arrived - free to share again")
					state.active = nil
					updateInfo()
					setStatus("Live - shared at " .. os.date("%H:%M:%S") .. " (room " .. room .. ")", THEME.green)
				end
			elseif state.active.player.Parent == nil and not state.active.started then
				setStatus(state.active.username .. " left before the trade could start.", THEME.red)
				-- Forget them. Their processed announcement stays processed, so it
				-- cannot be picked up again; a fresh one from them still can.
				state.active = nil
				updateInfo()
			end
		end

		waitSeconds(1)
	end
end)

